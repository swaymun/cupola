#!/usr/bin/env python3
"""Decide which CI jobs a change needs. Prints one `job=true|false` line per job.

  scripts/ci-changes BASE HEAD         # changed files from git diff
  scripts/ci-changes --files a b c     # explicit file list (for checks)
  scripts/ci-changes --plan BASE HEAD  # exact current groups, without legacy aliases
  scripts/ci-changes --rust-packages BASE HEAD  # affected Cargo package arguments

Each job lists the paths that can change its result. A file that matches no job
and is not known to be outside CI runs every job, so a new area is never silently
untested. Changing this script also runs everything.
"""
import re
import fnmatch
import json
import shlex
import runpy
import subprocess
import sys
from pathlib import Path

PLAN_VERSION = 2
ROOT = Path(__file__).resolve().parents[1]

JOBS = {
    # Copy can reach users through prepared Swift values and Rust HTTP/CLI errors.
    "docs": [r"^apps/ios/", r"^apps/native/Sources/", r"^crates/", r"^services/", r"^native/",
             r"^distribution/", r"^(?:un)?install\.(sh|ps1)$", r"^site/", r"^llms\.txt$",
             r"^scripts/(check-platform-wording|platform-wording-allowlist\.json|land)$",
             r"^scripts/", r"^tests/", r"^fastlane/", r"\.md$"],
    "rust": [r"^crates/(?!wonderd/computer-helper/)", r"^tests/fixtures/protocol/", r"^Cargo\.(toml|lock)$", r"^rust-toolchain", r"^\.cargo/", r"^packages/protocol/",
             r"^compatibility-manifest\.json$", r"^scripts/(check-provider-routing|provider-routing-baseline\.json)$"],
    # This MSVC/libwebrtc crate is deliberately outside the gnullvm workspace.
    "computer_helper": [r"^crates/wonderd/computer-helper/",
                        r"^scripts/(package-cli-release\.py|test-cli-distribution\.py|release-cli-linux\.sh|release-cli-windows\.ps1)$"],
    # Windows tiers 1-2 on a Boat box (scripts/vms/boat-windows): cross-build, clippy and Wine tests for the
    # Windows cfg paths, the MSVC computer helper via cargo-xwin, and install.ps1 under PowerShell 7. Rust sources join by content (windows_source).
    "windows": [r"^scripts/windows/", r"^scripts/vms/(?:boat-windows|test-boat-windows\.py)$", r"^(?:un)?install\.ps1$",
                r"^scripts/release-cli-windows\.ps1$", r"^Cargo\.(toml|lock)$", r"^rust-toolchain", r"^\.cargo/",
                r"^crates/(?!wonderd/computer-helper/)[^/]+/Cargo\.toml$",
                r"^crates/wonderd/computer-helper/(?:src/|tests/|\.cargo/|vendor/|Cargo\.(?:toml|lock)$|build\.rs$)"],
    "native": [r"^apps/native/", r"^packages/protocol/", r"^tests/fixtures/protocol/"],
    "computer_use": [r"^native/computer-use/", r"^scripts/verify-computer-use\.mjs$", r"^packages/protocol/"],
    # Tooling tests run only when their subject changes (test-orch alone took ~77 s per land).
    "orch": [r"^scripts/(orch|visual-gate|check-test-timeouts|overnight|cloud-setup\.sh|test-orch\.py|verify-main|sim-jobs|test-verify-main\.py|check-stack-depth|stack_depth_lldb\.py)$",
             r"^scripts/vms/"],
    "land_cleanup": [r"^scripts/(land|prune-merged-worktrees|(?:test-)?clean-build-artifacts\.py)$"],
    "land_tools": [r"^scripts/(land|ci-changes|preflight|test-land\.py)$", r"^crates/wonderd/computer-helper/check\.py$"],
    # Privacy/protocol fixture guards stay owning checks, rather than running for every copy edit.
    "session_fixtures": [r"^scripts/(?:generate-session-fixtures|replay-session-fixture|test-session-fixtures|test-replay-session-fixture|test-session-replay-http|run-live-fixtures|test-live-fixtures)\.py$",
                         r"^scripts/(preflight-live-fixtures|project-claude-fixtures)\.mjs$",
                         r"^scripts/(live-fixtures-requirements\.txt|fixtures/session-shapes\.json)$",
                         r"^research/codex-app-server/", r"^tests/fixtures/(session|code-mode-host\.py)", r"^packages/protocol/",
                         r"^services/claude-runtime/"],
    "nightly_tools": [r"^scripts/(nightly-sim|run-live-fixtures\.py|setup-nightly-sim|run-scenarios|check-cli-codex|"
                      r"live-fixtures-requirements\.txt|test-nightly-live-fixtures\.py|wonderctl|test-wonderctl\.py)$"],
    "push": [r"^services/push/"],
    "claude_runtime": [r"^services/(claude|acp)-runtime/"],
    # Landing stays static; the lead explicitly runs the bounded simulator smoke.
    "ios_checks": [r"^apps/ios/", r"^apps/native/", r"^scripts/(check-theme|check-project-language|check-provider-branches|check-privacy-manifests)$",
                   r"^scripts/(check-scenario-selectors|scenario-selectors-allowlist\.json|test-check-scenario-selectors\.py)$"],
    "ios_release": [r"^apps/ios/", r"^apps/native/"],
}
EVERYTHING = [r"^scripts/ci-changes$"]
# Areas no CI job builds or tests; changing them alone runs nothing.
OUTSIDE_CI = [r"\.md$", r"^\.github/", r"^\.claude/", r"^\.gitignore$", r"^fastlane/", r"^Gemfile",
              r"^docs/", r"^research/", r"^assets/", r"^evidence/", r"^artifacts/", r"^output/",
              r"^dist/", r"^licenses/", r"^LICENSE$", r"^provenance\.json$", r"^justfile$",
              r"^apps/pwa/",
              r"^scripts/"]


WINDOWS_CFG = re.compile(r'\bcfg(?:_attr)?!?\s*\(.*\b(?:windows|unix)\b|target_os\s*=\s*"windows"|windows[-_]sys|\bwindows::|os::windows')


def windows_source(path, root=None):
    """A workspace Rust file whose text selects or gates code by Windows/unix, or that is gone (a deletion can
    remove a Windows item). Plain portable files do not need the Windows tier; the Rust job covers them."""
    if not path.endswith('.rs') or not path.startswith('crates/') or path.startswith('crates/wonderd/computer-helper/'):
        return False
    try:
        return bool(WINDOWS_CFG.search(((root or ROOT) / path).read_text(errors='replace')))
    except OSError:
        return True


def decide(files, root=None):
    needed = {job: False for job in JOBS}
    for path in files:
        if any(re.search(p, path) for p in EVERYTHING):
            needed = {job: True for job in JOBS}
            break
        matched = [job for job, patterns in JOBS.items() if any(re.search(p, path) for p in patterns)]
        for job in matched:
            needed[job] = True
        if not matched and not any(re.search(p, path) for p in OUTSIDE_CI):
            needed = {job: True for job in JOBS}
            break
    if needed['orch']:  # the full suite already owns the land/cleanup subset
        needed['land_cleanup'] = False
    # Rust sources outside the declared patterns still select Cargo; unknown paths and
    # changes to this selector already failed closed to every job above.
    needed['rust'] |= any(rust_path(path) for path in files)
    needed['windows'] |= any(windows_source(path, root) for path in files)
    return needed


def rust_path(path):
    return (any(re.search(pattern, path) for pattern in JOBS['rust']) or
            path.endswith('.rs') and not path.startswith('crates/wonderd/computer-helper/'))


def rust_graph(root):
    result = subprocess.run(['cargo', 'metadata', '--no-deps', '--offline', '--locked', '--format-version', '1'],
                            cwd=root, capture_output=True, text=True, check=True)
    metadata = json.loads(result.stdout)
    members = {p['name']: p for p in metadata['packages'] if p['id'] in metadata['workspace_members']}
    directories = {name: Path(p['manifest_path']).resolve().parent for name, p in members.items()}
    by_directory = {directory: name for name, directory in directories.items()}
    dependencies = {name: {by_directory[Path(dep['path']).resolve()] for dep in package['dependencies']
                          if dep.get('path') and Path(dep['path']).resolve() in by_directory}
                    for name, package in members.items()}
    return members, directories, dependencies


def rust_dependents(owners, dependencies):
    selected = set(owners)
    while True:
        consumers = {name for name, deps in dependencies.items() if deps & selected}
        if consumers <= selected:
            return selected
        selected.update(consumers)


def rust_package_args(root, files):
    """Use Cargo's local dependency graph; never guess test names from filenames.

    A crate and its transitive dependents run all their tests/targets. Workspace manifests/lockfiles,
    protocol inputs and unrecognized/deleted members retain the workspace gate.
    --no-deps includes workspace path dependencies (normal, build, dev, optional
    and target-specific) without fetching the registry or pruning by host cfg.
    """
    paths = [p for p in files if rust_path(p)]
    if not paths or any(not p.startswith('crates/') for p in paths):
        return ['--workspace']
    try:
        _, directories, dependencies = rust_graph(root)
        owners = set()
        for path in paths:
            matches = [name for name, directory in directories.items() if (root / path).resolve().is_relative_to(directory)]
            if len(matches) != 1:
                return ['--workspace']
            owners.update(matches)
        return [arg for name in sorted(rust_dependents(owners, dependencies)) for arg in ('-p', name)] or ['--workspace']
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f'Cargo metadata unavailable; keeping workspace checks: {error}', file=sys.stderr)
        return ['--workspace']


def rust_macos_package_args(root, scope):
    """Keep platform-dependent Rust checks on the Mac as well as Linux.

    Whole owning packages are intentional: comparing test names misses cfg! in
    test bodies and tests of platform-specific production code with equal names.
    Include consumers of platform-dependent local dependencies, even unchanged
    dependencies outside the selected set. Unknown graph/build inputs fail closed.
    """
    try:
        members, directories, dependencies = rust_graph(root)
        selected = set(members) if scope == ['--workspace'] else set(scope[1::2])
        sensitive = set()
        for name, directory in directories.items():
            sources = [Path(members[name]['manifest_path']), *directory.rglob('*.rs')]
            if any(target['kind'] == ['custom-build'] for target in members[name]['targets']) or any(
                    re.search(r'\btarget_|\b(?:macos|darwin|apple)\b', path.read_text()) for path in sources):
                sensitive.add(name)
        local = selected & rust_dependents(sensitive, dependencies)
        return [arg for name in sorted(local) for arg in ('-p', name)]
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f'macOS Rust split unavailable; keeping selected checks locally too: {error}', file=sys.stderr)
        return scope


