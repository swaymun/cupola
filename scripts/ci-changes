ROOT = Path(__file__).resolve().parent.parent


def changed_files(root=ROOT, base="origin/main"):
    # Include staged and unstaged work as well as commits; use NULs for spaces.
    files = set()
    for arguments in (["diff", "--name-only", "-z", f"{base}...HEAD"],
                      ["diff", "--name-only", "-z", "HEAD"],
                      ["ls-files", "--others", "--exclude-standard", "-z"]):
        result = subprocess.run(["git", "-C", str(root), *arguments], capture_output=True, text=True)
        if result.returncode:
            raise ValueError(f"Cannot select tests: {result.stderr.strip()}")
        files.update(filter(None, result.stdout.split("\0")))
    return sorted(files)


def matches(value, patterns):
    return any(fnmatch.fnmatchcase(value, pattern) for pattern in patterns)


def catalog(root=ROOT):
    # Reuse the existing Swift-aware discovery (comments, raw strings, extensions,
    # inheritance). A new test need not be in the retired nightly manifest to run.
    scanner = runpy.run_path(str(root / "scripts/nightly-sim"))
    tests = scanner["xctest_ids"](root)
    lanes = {test: (lane, reason) for lane, test, reason, _ in
             scanner["read_xctest_manifest"](root / "apps/ios/control/xctests.txt")}
    native, snapshots, files = {}, {}, {}
    for folder, owners in [("apps/native/Tests", native), ("apps/ios/SnapshotTests", snapshots)]:
        for path in sorted((root / folder).rglob("*.swift")):
            code = scanner["swift_code"](path.read_text())
            names = re.findall(r"\b(?:class|struct)\s+(\w+)\s*(?::\s*XCTestCase\b|\{)", code)
            # Swift Testing suites use @Suite; helper types are not filters.
            if "@Suite" in code:
                names += re.findall(r"@Suite(?:\([^\n]*\))?\s+(?:@MainActor\s+)?struct\s+(\w+)", code)
            owners[str(path.relative_to(root))] = sorted(set(n for n in names if n.endswith("Tests")))
    for target in ("WonderDiagnosticsTests", "WonderUITests"):
        for path in (root / "apps/ios" / target).glob("*.swift"):
            code = scanner["swift_code"](path.read_text())
            classes = set(re.findall(r"\b(?:class|extension)\s+(\w+)", code))
            files[str(path.relative_to(root))] = [test for test in tests if test.split("/")[1] in classes]
    scenarios = sorted(str(path.relative_to(root)) for path in
                       (root / "apps/ios/control/scenarios").glob("*.wctl"))
    return tests, lanes, native, snapshots, files, scenarios


def select(files, phase="worker", device="iphone", root=ROOT):
    normalized = []
    for value in files:
        path = Path(value)
        if path.is_absolute():
            path = path.relative_to(root)
        if ".." in path.parts:
            raise ValueError(f"Test selection path escapes the checkout: {value}")
        normalized.append(path.as_posix())
    files = normalized
    config = IOS_OWNERS
    tests, lanes, native, snapshots, test_files, scenarios = catalog(root)
    plan = {"phase": phase, "device": device, "files": sorted(set(files)),
            "xctests": [], "native": [], "snapshots": [], "scenarios": [],
            "fallback": [], "opt_in": [], "not_applicable": []}
    selected = {key: set() for key in ("xctests", "native", "snapshots", "scenarios")}

    def add(rule):
        missing = []
        if not any(rule.get(key) for key in selected):
            missing.append("no declared test owner")
        for pattern in rule.get("xctests", []):
            found = [test for test in tests if matches(test, [pattern])]
            if not found:
                missing.append(pattern)
            selected["xctests"].update(found)
        for key, owners in (("native", native), ("snapshots", snapshots)):
            for pattern in rule.get(key, []):
                found = [name for path, names in owners.items() if matches(path, [pattern]) for name in names]
                if not found:
                    missing.append(pattern)
                selected[key].update(found)
        for pattern in rule.get("scenarios", []):
            found = [path for path in scenarios if matches(path, [pattern])]
            if not found:
                missing.append(pattern)
            selected["scenarios"].update(found)
        return missing

    def full():
        selected["xctests"].update(tests)
        selected["native"].update(name for names in native.values() for name in names)
        selected["snapshots"].update(name for names in snapshots.values() for name in names)
        selected["scenarios"].update(scenarios)

    if phase == "release":
        full()
    elif phase == "landing":
        if any((path.startswith(("apps/ios/", "apps/native/", "packages/protocol/")) and not path.endswith(".md")) or
               path in ("scripts/wonderctl", "scripts/ci-changes") for path in files):
            missing = add(config["smoke"])
            if missing:
                raise ValueError("Landing smoke owner is stale; update IOS_OWNERS: " + ", ".join(missing))
    else:
        for path in files:
            if path in config.get("shared_test_files", []):
                target = path.split("/")[2]
                selected["xctests"].update(test for test in tests if test.startswith(target + "/"))
            elif path in test_files:
                if test_files[path]:
                    selected["xctests"].update(test_files[path])
                else:  # A shared XCTest helper has no test methods of its own.
                    target = path.split("/")[2]
                    selected["xctests"].update(test for test in tests if test.startswith(target + "/"))
            elif path in native or path in snapshots:
                key, owners = ("native", native) if path in native else ("snapshots", snapshots)
                if owners[path]:
                    selected[key].update(owners[path])
                else:  # Shared test helpers affect every suite in their package.
                    selected[key].update(name for names in owners.values() for name in names)
            elif path in scenarios:
                selected["scenarios"].add(path)
            elif path.endswith(".md"):
                continue
            else:
                rules = [rule for rule in config["owners"] if matches(path, rule["paths"])]
                if rules:
                    for rule in rules:
                        if add(rule):
                            plan["fallback"].append(path + " (stale owner: " + rule["name"] + ")")
                            full()
                elif path.startswith(("apps/ios/", "apps/native/", "packages/protocol/")) or path in (
                        "scripts/wonderctl", "scripts/ci-changes"):
                    # New/renamed production files and shared contracts fail broad.
                    plan["fallback"].append(path)
                    full()
    for test in sorted(selected["xctests"]):
        lane, reason = lanes.get(test, ("iphone", "new test; no retired-nightly classification"))
        if lane == "duo" and device == "duo":
            plan["xctests"].append(test)
        elif lane not in ("iphone", "ipad", "smoothness"):
            plan["opt_in"].append({"test": test, "lane": lane, "reason": reason})
        elif lane == "ipad" and device != "ipad":
            plan["not_applicable"].append(test)
        else:
            plan["xctests"].append(test)
    for path in sorted(selected["scenarios"]):
        text = (root / path).read_text()
        allowed = re.search(r"^# devices:\s*(.+)$", text, re.M)
        if allowed and device not in allowed[1].split():
            plan["not_applicable"].append(path)
        else:
            plan["scenarios"].append(path)
    for key in ("native", "snapshots"):
        plan[key] = sorted(selected[key])
    return plan



def main(argv):
    if argv[:1] == ["--ios"]:
        import argparse
        parser = argparse.ArgumentParser(description="Select iOS checks by contract owner")
        parser.add_argument("--ios", choices=["worker", "landing", "release"], required=True)
        parser.add_argument("--device", choices=["iphone", "iphone-27", "ipad", "duo"], default="iphone")
        parser.add_argument("--base", default="origin/main")
        parser.add_argument("--files", nargs="*")
        args = parser.parse_args(argv)
        files = args.files if args.files is not None else changed_files(base=args.base)
        print(json.dumps(select(files, args.ios, args.device), indent=2))
        return
    exact_plan = argv[:1] == ['--plan']
    if exact_plan:
        argv = argv[1:]
    rust_only = argv[:1] == ['--rust-packages']
    if rust_only:
        argv = argv[1:]

    if argv[:1] == ["--files"]:
        files = argv[1:]
    elif len(argv) == 2:
        diff = subprocess.run(["git", "diff", "--name-only", "--no-renames", "-z", f"{argv[0]}...{argv[1]}"],
                              text=True, capture_output=True)
        if diff.returncode != 0:
            print(f"git diff failed ({diff.stderr.strip()}); running everything", file=sys.stderr)
            files = ["<unknown>"]
        else:
            files = [p for p in diff.stdout.split('\0') if p]
    else:
        sys.exit(__doc__)
    if rust_only:
        root = Path(subprocess.check_output(['git', 'rev-parse', '--show-toplevel'], text=True).strip())
        print(shlex.join(rust_package_args(root, files)))
        return
    needed = decide(files)
    if not exact_plan:
        # An already-running pre-v2 land can rebase onto this selector. Its
        # original composite groups must still cover the newly split owners.
        needed['native'] |= needed['computer_use']
        needed['orch'] |= needed['land_cleanup']
        needed['docs'] |= needed['session_fixtures']
    for job, run in needed.items():
        print(f"{job}={'true' if run else 'false'}")


if __name__ == "__main__":
    main(sys.argv[1:])
