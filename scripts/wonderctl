CORE_SIMCTL = "/Library/Developer/PrivateFrameworks/CoreSimulator.framework/Versions/A/Resources/bin/simctl"
# Simulators are per machine, so their lock is too.
LOCKS = Path.home() / "Library/Caches/wonderctl"
POOL_KINDS = ("iphone", "ipad", "duo")
