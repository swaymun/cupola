IPHONES = ("iPhone 17 Pro", "iPhone 17", "iPhone 16 Pro", "iPhone 16")
# Profile: simulator name, device types to try, and the iOS major version it is pinned to
# (None: the newest runtime that supports the device). The nightly run (scripts/nightly-sim)
# uses iphone, duo and ipad; iphone-27 is for checking iOS 27.0 on an iPhone by hand.
PROFILES = {
    "iphone": ("Wonder Control iPhone", IPHONES, "26"),
    "iphone-27": ("Wonder Control iPhone 27", IPHONES, "27"),
    "duo": ("Wonder Control iPhone Duo", ("iPhone Duo",), None),
    "ipad": ("Wonder Control iPad", ("iPad Pro 11-inch (M5)", "iPad Pro 11-inch (M4)"), "27"),
}
# Legacy manual suffix support. Orch and nightly use disposable pooled lanes.
SIMULATOR_SUFFIX = os.environ.get("WONDER_CONTROL_SIMULATOR_SUFFIX", "").strip()


def profile(name):
    simulator, types, major = PROFILES[name]
    return (f"{simulator} {SIMULATOR_SUFFIX}" if SIMULATOR_SUFFIX else simulator), types, major


DEVICE_NAME, DEVICE_TYPES, DEVICE_MAJOR = profile(os.environ.get("WONDER_CONTROL_PROFILE", "iphone"))
