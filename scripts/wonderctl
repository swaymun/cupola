                  ".build/", "DerivedData/", "__pycache__/"]


HOLDS_LOCK = False


class ControlError(Exception):
    pass


_guard_fds = threading.local()


@contextlib.contextmanager
def inherited_lock(descriptor):
    """An orphaned compiler/simslim must keep the resources it is still using."""
    previous = getattr(_guard_fds, "value", ())
    _guard_fds.value = (*previous, descriptor)
    try:
        yield
    finally:
        _guard_fds.value = previous


@contextlib.contextmanager
def host_state(name, blocking=True):
    """Host-wide transactions, shared by every checkout. Never replace the lock inode."""
    LOCKS.mkdir(parents=True, exist_ok=True)
    with (LOCKS / f"{name}.lock").open("a+") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        path = LOCKS / f"{name}.json"
        state = json.loads(path.read_text()) if path.exists() else {}
        with inherited_lock(guard.fileno()):
            try:
                yield state
            finally:
                save_host_state(name, state)


def save_host_state(name, state):
    """Caller owns host_state's guard. Checkpoint device receipts before slow operations."""
    path = LOCKS / f"{name}.json"
    temporary = path.with_suffix(f".{os.getpid()}.tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    temporary.replace(path)


def pid_alive(pid):
    if not isinstance(pid, int) or pid < 2:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def build_ticket_alive(ticket):
    if not ticket.get("active"):
        return pid_alive(ticket["pid"])
    # The xcodebuild child inherits this flock. Killing wonderctl must not free
    # its slot while the compiler is still running. PIDs alone cannot prove that.
    path = LOCKS / ("build-holder-" + ticket["id"] + ".lock")
    with path.open("a+") as guard:
        try:
            fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return True
    path.unlink(missing_ok=True)
    return False


@contextlib.contextmanager
def build_slot():
    """FIFO admission to N host-wide builds, including orphaned compiler children."""
    ticket = {"id": uuid.uuid4().hex, "pid": os.getpid(), "checkout": str(ROOT), "active": False}
    holder = None
    last_progress = 0
    try:
        while True:
            with host_state("build-queue") as state:
                queue = state.setdefault("queue", [])
                queue[:] = [entry for entry in queue if build_ticket_alive(entry)]
                if not any(entry["id"] == ticket["id"] for entry in queue):
                    queue.append(ticket)
                ticket = next(entry for entry in queue if entry["id"] == ticket["id"])
                limit = int(state.get("limit", 2))
                waiting = [entry for entry in queue if not entry["active"]]
                active = sum(bool(entry["active"]) for entry in queue)
                if waiting[0]["id"] == ticket["id"] and active < limit:
                    holder = (LOCKS / ("build-holder-" + ticket["id"] + ".lock")).open("a+")
                    fcntl.flock(holder, fcntl.LOCK_EX)
                    ticket["active"] = True
                    print(f"build slot acquired ({active + 1}/{limit})", file=sys.stderr, flush=True)
                    break
                if time.monotonic() - last_progress >= 10:
                    position = next(i + 1 for i, entry in enumerate(waiting) if entry["id"] == ticket["id"])
                    print(f"waiting for build slot: FIFO position {position}, {active}/{limit} running", file=sys.stderr, flush=True)
                    last_progress = time.monotonic()
            time.sleep(0.2)
        yield holder.fileno()
    finally:
        if holder:
            holder.close()
        with host_state("build-queue") as state:
            # Keep a surviving compiler child's inherited lock in the ledger.
            state["queue"] = [entry for entry in state.get("queue", [])
                              if entry["id"] != ticket["id"] or (entry["active"] and build_ticket_alive(entry))]


def compilation_cache():
    """Host-wide storage contract; the storage lifecycle owner handles eviction."""
    path = Path(os.environ.get("WONDER_CONTROL_CACHE_PATH") or
                Path.home() / "Library/Caches/wonderctl/CompilationCache.noindex").expanduser()
    if not path.is_absolute():
        raise ControlError("WONDER_CONTROL_CACHE_PATH must be absolute (shared across worktrees)")
    try:
        budget = int(os.environ.get("WONDER_CONTROL_CACHE_BUDGET_BYTES", str(8 * 1024 ** 3)))
        if budget <= 0:
            raise ValueError()
    except ValueError:
        raise ControlError("WONDER_CONTROL_CACHE_BUDGET_BYTES must be a positive integer") from None
    return {"path": str(path), "budget_bytes": budget}


def cmd_cache_info(args):
    print(json.dumps(compilation_cache(), indent=2))


def fast_simulator_command(command, optimized=False):
    """Defaults for Diagnostics simulator callers, including nightly's imported wrapper.

    Release, device builds, explicit settings and test-without-building are untouched.
    """
    command = list(command)
    def option(name):
        return command[command.index(name) + 1] if name in command else ""
    destination = option("-destination")
    # CoreSimulator uses UUIDs; physical-device identifiers do not have this form.
    simulator_id = re.fullmatch(r"id=[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", destination)
    if (optimized or os.environ.get("WONDER_CONTROL_OPTIMIZED") == "1" or
            option("-scheme") != "Diagnostics" or option("-configuration") != "Diagnostics" or
            "test-without-building" in command or option("-sdk").startswith("iphoneos") or
            not ("platform=iOS Simulator" in destination or simulator_id)):
        return command
    cache = compilation_cache()
    settings = {
        "ONLY_ACTIVE_ARCH": "YES", "ARCHS": os.uname().machine,
        "SWIFT_COMPILATION_MODE": "singlefile", "SWIFT_OPTIMIZATION_LEVEL": "-Onone",
        "DEBUG_INFORMATION_FORMAT": "dwarf", "ENABLE_DEBUG_DYLIB": "NO",
        "COMPILATION_CACHE_ENABLE_CACHING": "YES", "SWIFT_ENABLE_COMPILE_CACHE": "YES",
        "COMPILATION_CACHE_CAS_PATH": cache["path"],
    }
    if os.environ.get("WONDER_CONTROL_PREFIX_MAPPING", "1") != "0":
        # Xcode's project mapping covers apps/ios; map the enclosing checkout and
        # DerivedData too (package sources and generated module inputs live there).
        mappings = f'$(inherited) "{ROOT}=/^checkout" "$(SYMROOT)=/^symroot" "$(OBJROOT)=/^objroot" "$(SDK_STAT_CACHE_DIR)=/^dd"'
        for compiler in ("SWIFT", "CLANG"):
            settings[compiler + "_ENABLE_PREFIX_MAPPING"] = "YES"
            settings[compiler + "_ENABLE_PROJECT_PREFIX_MAPPING"] = "YES"
            settings[compiler + "_OTHER_PREFIX_MAPPINGS"] = mappings
    else:
        for compiler in ("SWIFT", "CLANG"):
            settings[compiler + "_ENABLE_PREFIX_MAPPING"] = "NO"
            settings[compiler + "_ENABLE_PROJECT_PREFIX_MAPPING"] = "NO"
    explicit = {arg.split("=", 1)[0] for arg in command if "=" in arg}
    return command + [f"{key}={value}" for key, value in settings.items() if key not in explicit]


def run_xcodebuild(command, *, optimized=False, **kwargs):
    command = fast_simulator_command(command, optimized)
    # Ownership metadata only: pool admission and concurrency limits are unchanged.
    with build_slot() as descriptor:
        if '-derivedDataPath' not in command:
            return subprocess.run(command, pass_fds=(descriptor, *getattr(_guard_fds, 'value', ())), **kwargs)
        output = Path(command[command.index('-derivedDataPath') + 1]).absolute()
        try:
            storage = runpy.run_path(str(Path(__file__).with_name('clean-build-artifacts.py')))
        except OSError:
            # Older/fixture checkouts without the additive registry retain output.
            return subprocess.run(command, pass_fds=(descriptor, *getattr(_guard_fds, 'value', ())), **kwargs)
        root = storage['main_root'](ROOT)
        try:
            storage['artifact_path'](root, output)
        except ValueError:
            print(f'storage: output outside managed Wonder paths; retained without expiry: {output}', file=sys.stderr)
            return subprocess.run(command, pass_fds=(descriptor, *getattr(_guard_fds, 'value', ())), **kwargs)
        revision = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
        with storage['artifact_use'](root, output, 'cache-ios',
                os.environ.get('WONDER_STORAGE_UNIT', ROOT.name.removeprefix('wt-')), revision,
                os.environ.get('WONDER_STORAGE_STORE')) as artifact_descriptor:
            return subprocess.run(command, pass_fds=(descriptor, artifact_descriptor,
                                  *getattr(_guard_fds, 'value', ())), **kwargs)


def lock_name(kind, suffix=None, device_udid=None):
    """One canonical device lock for pool maintenance and all controller actions."""
    if device_udid:
        return "device-" + device_udid
    suffix = SIMULATOR_SUFFIX if suffix is None else suffix
    return f"{kind}-{suffix}" if suffix else kind


@contextlib.contextmanager
def device_lock(device_udid, blocking=True):
    LOCKS.mkdir(parents=True, exist_ok=True)
    with (LOCKS / (lock_name(None, device_udid=device_udid) + ".lock")).open("a+") as guard:
        fcntl.flock(guard, fcntl.LOCK_EX | (0 if blocking else fcntl.LOCK_NB))
        with inherited_lock(guard.fileno()):
            yield


def lane_holder():
    return os.environ.get("WONDER_CONTROL_HOLDER") or str(ROOT)


def lane_for(kind):
    # Reading is atomic; main takes the device lock and validates again before use.
    path = LOCKS / "sim-pool.json"
    state = json.loads(path.read_text()) if path.exists() else {}
    return next((slot for slot in state.get("slots", []) if slot["kind"] == kind
                 and slot.get("lease", {}).get("holder") == lane_holder()
                 and pid_alive(slot["lease"]["pid"])), None)


def pool_device(slot):
    found = next((d for _, d in devices(available=False) if d["udid"] == slot.get("udid")), None)
    if found and found["name"] != slot["name"]:
        raise ControlError("pool device identity changed; refusing to touch it")
    return found


def pool_delete(slot):
    """Only delete a UUID/name pair this pool created, while its device lock is held."""
    device = pool_device(slot)
    if device:
        if not device["name"].startswith("Wonder Control Pool "):
            raise ControlError("refusing to delete a device outside the pool")
        try:
            if device["state"] == "Booted":
                simctl("shutdown", device["udid"], timeout=120)
            simctl("delete", device["udid"], timeout=120)
        except (ControlError, OSError, subprocess.SubprocessError) as error:
            # A device CoreSimulator already lost (disk-full cleanup, manual erase) or one
            # it refuses to delete must not wedge every reap; the name is never reused.
            print(f"pool: dropping lane record {slot['name']} after simctl failure: {error}",
                  file=sys.stderr, flush=True)
    slot.pop("udid", None)
    slot.pop("lease", None)
    slot["ready"] = False


def pool_profile(kind):
    global DEVICE_NAME, DEVICE_TYPES, DEVICE_MAJOR, _target
    DEVICE_NAME, DEVICE_TYPES, DEVICE_MAJOR = PROFILES[kind]
    _target = None
    return target_runtime()


def pool_golden(state, kind):
    runtime, device_type = pool_profile(kind)
    goldens = state.setdefault("goldens", {})
    golden = goldens.get(kind)
    if golden and not golden.get("udid"):
        partial = next((d for _, d in devices(available=False) if d["name"] == golden["name"]), None)
        if partial:
            golden["udid"] = partial["udid"]
    if golden and golden.get("runtime") == runtime and golden.get("ready") and pool_device(golden):
        return golden
    if golden and golden.get("udid"):
        with device_lock(golden["udid"]):
            pool_delete(golden)
    golden = {"name": f"Wonder Control Pool Golden {kind} {uuid.uuid4().hex[:10]}", "runtime": runtime}
    goldens[kind] = golden
    print(f"preparing slim golden {kind}", file=sys.stderr, flush=True)
    save_host_state("sim-pool", state)
    golden["udid"] = simctl("create", golden["name"], device_type, runtime).stdout.strip()
    save_host_state("sim-pool", state)
    with device_lock(golden["udid"]):
        simctl("boot", golden["udid"])
        simctl("bootstatus", golden["udid"], "-b", timeout=300)
        sh(["simslim", "on", golden["udid"]], timeout=900)
        simctl("shutdown", golden["udid"])
        clean_pool_caches(golden)
        golden["ready"] = True
    return golden


def clean_pool_caches(slot):
    """Disposable cache data only, inside a shutdown pool-owned device, never symlinks."""
    device = pool_device(slot)
    if not device or device["state"] == "Booted":
        return
    base = (Path.home() / "Library/Developer/CoreSimulator/Devices").resolve()
    root = base / device["udid"] / "data"
    if root.resolve() != root:
        raise ControlError("refusing cache cleanup through a symlinked device data directory")
    patterns = ("Library/Caches/com.apple.nsurlsessiond/Downloads/**/*.dmg",
                "Library/com.apple.nsurlsessiond/Downloads/**/*.dmg",
                "Library/Caches/com.apple.coresymbolicationd",
                "Containers/Data/*/*/Library/Caches/com.apple.nsurlsessiond/Downloads/**/*.dmg",
                "Containers/Data/*/*/Library/com.apple.nsurlsessiond/Downloads/**/*.dmg",
                "Containers/Data/*/*/Library/Caches/com.apple.coresymbolicationd")
    for pattern in patterns:
        for path in root.glob(pattern):
            if path.is_symlink() or not path.resolve().is_relative_to(root):
                continue
            if path.is_dir():
                shutil.rmtree(path)
            else:
                path.unlink(missing_ok=True)


def pool_size(state, kind):
    """Configured lane count, bounded by the cap of a run that is still alive."""
    size = state.get("sizes", {}).get(kind, 0)
    cap = state.get("cap")
    if cap and pid_alive(cap.get("pid")) and kind in cap.get("sizes", {}):
        return min(size, cap["sizes"][kind])
    return size


def pool_fill(state, kind):
    slots = state.setdefault("slots", [])
    size = pool_size(state, kind)
    if not size:
        return
    golden = pool_golden(state, kind)
    while sum(slot["kind"] == kind for slot in slots) < size:
        slots.append({"kind": kind, "name": f"Wonder Control Pool Lane {kind} {uuid.uuid4().hex[:10]}"})
    for slot in slots:
        if slot["kind"] != kind or slot.get("lease"):
            continue
        if not slot.get("udid"):
            # A killed clone command may have created its reserved, unique name
            # before returning its UUID. Recover that receipt rather than leak it.
            partial = next((d for _, d in devices(available=False) if d["name"] == slot["name"]), None)
            if partial:
                slot["udid"] = partial["udid"]
        if slot.get("udid"):
            with device_lock(slot["udid"]):
                existing = pool_device(slot)
                if (existing and slot.get("ready") and slot.get("profile_version") == 1
                        and slot.get("golden") == golden["udid"]):
                    if existing["state"] != "Booted":
                        simctl("boot", slot["udid"])
                        simctl("bootstatus", slot["udid"], "-b", timeout=300)
                    continue
                pool_delete(slot)
        slot["ready"] = False
        print(f"preparing cloned lane {kind}", file=sys.stderr, flush=True)
        save_host_state("sim-pool", state)
        with device_lock(golden["udid"]):
            # simslim wraps `xcrun simctl clone` (APFS COW), copies the managed
            # service profile, rebases source paths, and audits independence.
            # Raw simctl clone + repair-clone preserves a *stock* profile: never
            # hand out that silently unslimmed clone (measured on iOS 26.5).
            try:
                sh(["simslim", "clone", golden["udid"], slot["name"]], timeout=900)
            finally:
                created = next((d for _, d in devices(available=False) if d["name"] == slot["name"]), None)
                if created:
                    slot["udid"] = created["udid"]
            if not created:
                raise ControlError("simslim clone returned without its reserved device")
        save_host_state("sim-pool", state)
        with device_lock(slot["udid"]):
            simctl("boot", slot["udid"])
            simctl("bootstatus", slot["udid"], "-b", timeout=300)
            sh(["simslim", "verify", slot["udid"]], timeout=120)
            slot["profile_version"] = 1
            slot["golden"] = golden["udid"]
            slot["ready"] = True


def pool_reclaim(state, allow_booted=True, protect_nightly=False):
    for slot in state.get("slots", []):
        lease = slot.get("lease")
        if lease and not pid_alive(lease["pid"]):
            if protect_nightly and lease.get("holder", "").startswith("nightly:"):
                continue
            try:
                device = pool_device(slot)
                if device and device["state"] == "Booted" and not allow_booted:
                    continue  # A background reaper never shuts down a booted device.
                with device_lock(slot["udid"], blocking=False):
                    print(f"reclaiming dead lane owner {lease['pid']}", file=sys.stderr, flush=True)
                    pool_delete(slot)
            except BlockingIOError:
                continue  # An in-flight command still owns it even if its worker died.
            except ControlError as error:
                # Identity mismatch or a device outside the pool: keep the receipt, reap the rest.
                print(f"pool: skipped reclaiming {slot.get('name')}: {error}", file=sys.stderr, flush=True)
    state["queue"] = [entry for entry in state.get("queue", []) if pid_alive(entry["pid"])]


def pool_init(sizes, build_limit=None, legacy_reap=None, minimum=False, cap=False):
    reservation = release_pass_reservation()
    if reservation and os.environ.get("WONDER_CONTROL_RELEASE_TOKEN") != reservation.get("token"):
        raise ControlError("release-pass reserves the pool; initialization/resize deferred until it exits")
    if any(kind not in POOL_KINDS or not isinstance(size, int) or size < 0 for kind, size in sizes.items()):
        raise ControlError("pool sizes must be nonnegative integers for iphone, ipad or duo")
    if build_limit is not None:
        if build_limit < 1:
            raise ControlError("build limit must be a positive integer")
        with host_state("build-queue") as state:
            state["limit"] = build_limit
    with host_state("sim-pool") as state:
        if legacy_reap is not None:
            state["allow_legacy_reap"] = legacy_reap
        pool_reclaim(state)
        if cap:
            # The run that owns this pool bounds every later initializer (nightly, workers)
            # for as long as its process lives; --minimum only grows within that bound.
            state["cap"] = {"sizes": dict(sizes), "pid": os.getppid()}
        elif minimum:
            sizes = {kind: max(size, state.get("sizes", {}).get(kind, 0)) for kind, size in sizes.items()}
        state.setdefault("sizes", {}).update(sizes)
        sizes = {kind: pool_size(state, kind) for kind in sizes}
        state["sizes"].update(sizes)
        for kind, size in sizes.items():
            # Downsize idle slots only; a running unit keeps its lane.
            rows = [slot for slot in state.get("slots", []) if slot["kind"] == kind]
            for slot in reversed(rows):
                if len(rows) <= size:
                    break
                if slot.get("lease"):
                    continue
                if slot.get("udid"):
                    with device_lock(slot["udid"]):
                        pool_delete(slot)
                state["slots"].remove(slot)
                rows.remove(slot)
            pool_fill(state, kind)


def release_pass_reservation():
    """A kernel lock owns release admission, even if its JSON survives SIGKILL."""
    path = LOCKS / "release-pass.lock"
    if not path.exists():
        return None
    with path.open("a+") as guard:
        try:
            fcntl.flock(guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return None
        except BlockingIOError:
            try:
                return json.loads((LOCKS / "release-pass.json").read_text())
            except (OSError, ValueError):
                return {"token": "initializing"}


def lane_acquire(kind, owner_pid, timeout=600, cancelled=None):
    if not math.isfinite(timeout) or timeout < 0:
        raise ControlError("lane timeout must be finite and nonnegative")
    if not pid_alive(owner_pid):
        raise ControlError("lane owner must be a living worker PID (pass --owner-pid)")
    ticket = {"id": uuid.uuid4().hex, "pid": os.getpid(), "kind": kind,
              "release_token": os.environ.get("WONDER_CONTROL_RELEASE_TOKEN", "")}
    deadline, last_progress = time.monotonic() + timeout, 0
    try:
        while True:
            if cancelled and cancelled():
                raise ControlError('preview renderer startup cancelled')
            with host_state("sim-pool") as state:
                pool_reclaim(state)
                existing = next((slot for slot in state.get("slots", []) if slot["kind"] == kind
                                 and slot.get("lease", {}).get("holder") == lane_holder()), None)
                if existing:
                    if existing["lease"]["pid"] != owner_pid:
                        raise ControlError("this holder already has a lane owned by another PID")
                    return dict(existing)
                if pool_size(state, kind) < 1:
                    raise ControlError(f"no {kind} pool configured; run: wonderctl pool init --{kind} N")
                queue = state.setdefault("queue", [])
                if not any(entry["id"] == ticket["id"] for entry in queue):
                    queue.append(ticket)
                reservation = release_pass_reservation()
                eligible = [entry for entry in queue if entry["kind"] == kind and
                            (not reservation or entry.get("release_token") == reservation.get("token"))]
                first = eligible[0] if eligible else None
                if first and first["id"] == ticket["id"]:
                    rows = [slot for slot in state.get("slots", []) if slot["kind"] == kind]
                    if len(rows) < pool_size(state, kind) or any(not slot.get("lease") for slot in rows):
                        pool_fill(state, kind)
                    slot = next((slot for slot in state["slots"] if slot["kind"] == kind
                                 and slot.get("ready") and not slot.get("lease")), None)
                    if slot:
                        slot["lease"] = {"pid": owner_pid, "holder": lane_holder(), "checkout": str(ROOT)}
                        queue.remove(ticket)
                        return dict(slot)
                if time.monotonic() >= deadline:
                    raise ControlError(f"timed out waiting for {kind} lane")
                if time.monotonic() - last_progress >= 10:
                    position = [e for e in queue if e["kind"] == kind].index(ticket) + 1
                    print(f"waiting for {kind} lane: FIFO position {position}", file=sys.stderr, flush=True)
                    last_progress = time.monotonic()
            time.sleep(0.2)
    finally:
        with host_state("sim-pool") as state:
            state["queue"] = [e for e in state.get("queue", []) if e["id"] != ticket["id"]]


def lane_release(kind, refill=True):
    with host_state("sim-pool") as state:
        for slot in state.get("slots", []):
            if slot["kind"] == kind and slot.get("lease", {}).get("holder") == lane_holder():
                with device_lock(slot["udid"], blocking=False):
                    pool_delete(slot)
                if refill:
                    pool_fill(state, kind)
                return


def reap_legacy_devices(state):
    """Opt-in migration only: old suffix devices have no pool ownership receipt.

    Default is inventory, because this run forbids deleting pre-existing devices.
    Even with explicit migration permission, preserve booted/nightly/default
    devices, the manual lease, and both old profile locks and new UUID locks.
    """
    managed = {slot.get("udid") for slot in [*state.get("goldens", {}).values(), *state.get("slots", [])]}
    candidates = []
    for _, device in list(devices(available=False)):
        name = device["name"]
        if device["udid"] in managed or device["state"] != "Shutdown" or "nightly" in name.lower():
            continue
        match = next(((kind, name[len(base) + 1:]) for kind, (base, _, _) in
                      sorted(PROFILES.items(), key=lambda item: len(item[1][0]), reverse=True)
                      if name.startswith(base + " ")), None)
        if not name.startswith("Wonder Control ") or name in {p[0] for p in PROFILES.values()}:
            continue
        # Unknown legacy names and receipt-less pool orphans still belong to the
        # opt-in inventory. Their UUID lock is canonical; known profiles also
        # take the old suffix lock for compatibility with older controllers.
        kind, suffix = match or ("orphan", device["udid"])
        candidates.append({"udid": device["udid"], "name": name})
        if not state.get("allow_legacy_reap") or read_lease():
            continue
        try:
            with (LOCKS / "simulator-lease.lock").open("a+") as manual_guard, \
                    (LOCKS / (lock_name(kind, suffix) + ".lock")).open("a+") as old_guard:
                fcntl.flock(manual_guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
                if read_lease():
                    continue  # Atomic with take_lease; a new manual holder wins safely.
                fcntl.flock(old_guard, fcntl.LOCK_EX | fcntl.LOCK_NB)
                with inherited_lock(manual_guard.fileno()), inherited_lock(old_guard.fileno()), \
                        device_lock(device["udid"], blocking=False):
                    current = next((d for _, d in devices() if d["udid"] == device["udid"]), None)
                    if current and current["name"] == name and current["state"] == "Shutdown":
                        simctl("delete", device["udid"])
                        print(f"reaped legacy {name}", file=sys.stderr, flush=True)
        except BlockingIOError:
            continue
    state["legacy_candidates"] = candidates


def pool_reap(nonblocking=False, reclaim_booted=False):
    reap_stale_manual_lease()
    with host_state("sim-pool", blocking=not nonblocking) as state:
        pool_reclaim(state, allow_booted=reclaim_booted, protect_nightly=True)
        # Reclaim only UUID/name pairs recorded by this pool. Legacy suffix lanes,
        # the nightly's devices and the owner's devices have no ownership receipt.
        for slot in [*state.get("goldens", {}).values(), *state.get("slots", [])]:
            if not slot.get("udid") or slot.get("lease"):
                continue
            try:
                with device_lock(slot["udid"], blocking=False):
                    clean_pool_caches(slot)
            except BlockingIOError:
                continue
        reap_legacy_devices(state)


def cmd_pool(args):
    if args.action == "init":
        sizes = {kind: getattr(args, kind) for kind in POOL_KINDS if getattr(args, kind) is not None}
        pool_init(sizes, args.build_limit, True if args.allow_legacy_reap else None, minimum=args.minimum, cap=args.cap)
    elif args.action == "reap":
        try:
            pool_reap(args.nonblocking, args.reclaim_booted)
        except BlockingIOError:
            return
    path = LOCKS / "sim-pool.json"
    print(path.read_text() if path.exists() else "{}")


def cmd_lane(args):
    if args.action == "status":
        # One line of JSON for callers deciding whether to lease per check: does this holder
        # already own a lane of the kind, and is a pool of that kind configured at all?
        held = lane_for(args.kind)
        path = LOCKS / "sim-pool.json"  # read-only: status must never rewrite the live pool
        configured = pool_size(json.loads(path.read_text()) if path.exists() else {}, args.kind) > 0
        print(json.dumps({"held": held["udid"] if held else None, "configured": configured}))
    elif args.action == "acquire":
        slot = lane_acquire(args.kind, args.owner_pid, args.timeout)
        print(slot["udid"])
    else:
        lane_release(args.kind, refill=not args.no_refill)


def sh(cmd, check=True, capture=True, env=None, timeout=None):
    result = subprocess.run(cmd, text=True, capture_output=capture, env=env, timeout=timeout,
                            pass_fds=getattr(_guard_fds, "value", ()))
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() if capture else ""
        raise ControlError(f"{shlex.join(cmd)} failed ({result.returncode}): {detail[-2000:]}")
    return result


def axe_binary():
    path = shutil.which("axe") or "/opt/homebrew/bin/axe"
    if not Path(path).exists():
        raise ControlError("AXe is not installed: brew install cameroncooke/axe/axe")
    return path


def axe(args, **kwargs):
    # DTUHID drops queued input when the short-lived AXe process exits. Its
    # default 25ms missed taps on iPhone and Duo; keep the connection alive.
    env = dict(os.environ)
    env.setdefault("AXE_HID_STABILIZATION_MS", "500")
    return sh([axe_binary(), *args], env=env, **kwargs)


_simctl = None


def simctl(*args, **kwargs):
    # Xcode's simctl wrapper can add ~20s per call; call the CoreSimulator tool it execs.
    global _simctl
    if not _simctl:
        _simctl = CORE_SIMCTL if Path(CORE_SIMCTL).exists() else sh(["xcrun", "--find", "simctl"]).stdout.strip()
    return sh([_simctl, *args], **kwargs)


def devices(available=True):
    data = json.loads(simctl("list", "devices", *(["available"] if available else []), "-j").stdout)
    for runtime, entries in data["devices"].items():
        if "iOS" in runtime:
            for entry in entries:
                yield runtime, entry


_target = None
_preview_device = None
_preview_signals = None


def target_runtime():
    """The runtime identifier and device type this profile's simulator should use: the
    newest installed runtime of its pinned major version that supports one of its types.
    A runtime can support only some devices (iOS 27.1 ships for the Duo alone)."""
    global _target
    if _target:
        return _target
    runtimes = json.loads(simctl("list", "runtimes", "available", "-j").stdout)["runtimes"]
    ios = sorted((r for r in runtimes if r["platform"] == "iOS"
                  and (not DEVICE_MAJOR or r["version"].split(".")[0] == DEVICE_MAJOR)),
                 key=lambda r: [int(part) for part in r["version"].split(".")])
    for runtime in reversed(ios):
        supported = {t["name"]: t["identifier"] for t in runtime.get("supportedDeviceTypes", [])}
        kind = next((supported[name] for name in DEVICE_TYPES if name in supported), None)
        if kind:
            _target = (runtime["identifier"], kind)
            return _target
    version = f"iOS {DEVICE_MAJOR}" if DEVICE_MAJOR else "iOS"
    raise ControlError(f"no installed {version} simulator runtime supports any of {DEVICE_TYPES}; "
                       f"install one with: xcodebuild -downloadPlatform iOS -buildVersion VERSION")


def find_device():
    if _preview_device is not None:
        return _preview_device
    lane = lane_for(os.environ.get("WONDER_CONTROL_PROFILE", "iphone"))
    if lane:
        found = pool_device(lane)
        if not found:
            raise ControlError("leased pool device disappeared; release and acquire a fresh lane")
        return found
    runtime, _ = target_runtime()
    return next((d for r, d in devices() if d["name"] == DEVICE_NAME and r == runtime), None)


def create_device():
    runtime, kind = target_runtime()
    # A same-named simulator on another runtime is this profile's old one; remove it so
    # the name stays unambiguous in Simulator and simctl.
    for r, d in list(devices()):
        if d["name"] == DEVICE_NAME and r != runtime:
            if d["state"] == "Booted":
                simctl("shutdown", d["udid"], check=False)
            simctl("delete", d["udid"])
    simctl("create", DEVICE_NAME, kind, runtime)
    return find_device()


def ensure_device(boot=True):
    device = find_device() or create_device()
    if boot and device["state"] != "Booted":
        simctl("boot", device["udid"], check=False)
        simctl("bootstatus", device["udid"], "-b", timeout=300)
        device = find_device()
        if not driver_mode():
            wait_for_automation(device["udid"])
    return device


def wait_for_automation(device_udid, limit=120):
    # The first accessibility session after boot can take minutes (iPhone Duo especially).
    deadline = time.time() + limit
    while True:
        result = axe(["describe-ui", "--udid", device_udid], check=False)
        if result.returncode == 0:
            return
        if time.time() > deadline:
            raise ControlError(f"accessibility automation not ready after {limit}s: {result.stderr.strip()[-200:]}")
        time.sleep(3)


def udid():
    device = find_device()
    if not device or device["state"] != "Booted":
        raise ControlError(f"'{DEVICE_NAME}' is not booted; run: scripts/wonderctl device")
    return device["udid"]


def rig_display(inventory, width, height):
    """Select only measured cover/inner orientations, rejecting stale AX bounds."""
    displays = re.findall(r"Unique ID:\s*(\S+)(.*?)(?=Unique ID:|\Z)", inventory, re.S)
    size = sorted((float(width), float(height)))
    selected = []
    for ident, block in displays:
        match = re.search(r"Device Name:\s*(\S+).*?Screen Type:\s*Integrated.*?Pixel Size:\s*\{(\d+),\s*(\d+)\}.*?Preferred UI Scale:\s*(\d+)", block, re.S)
        if not match:
            continue
        name, w, h, scale = match.groups()
        if name not in {"primary", "primary-1"} or int(scale) <= 0:
            continue
        if all(abs(a-b) < 1 for a,b in zip(size, sorted((int(w)/int(scale), int(h)/int(scale))))):
            selected.append((ident, name, block, (int(w)/int(scale), int(h)/int(scale))))
    if len(selected) != 1:
        raise ControlError("simrig cannot identify the active simulator display from its point size")
    ident, name, block, points = selected[0]
    orientation = re.search(r"UI Orientation:\s*([^\n]+)", block)
    orientation = orientation[1].strip() if orientation else None
    qualified = ((name == "primary" and orientation == "Portrait") or
                 (name == "primary-1" and orientation in {"Landscape Left", "Portrait Upside Down"}))
    oriented = points[::-1] if orientation == "Landscape Left" else points
    if not qualified or any(abs(a-b) >= 1 for a,b in zip(map(float, (width, height)), oriented)):
        raise ControlError("simrig tap orientation or bounds are unqualified; use a portrait cover or the measured Duo inner postures")
    return ident, orientation, points, name


def rig_tap(inventory, x, y, width, height):
    ident, orientation, (natural_width, natural_height), name = rig_display(inventory, width, height)
    x, y, width, height = map(float, (x, y, width, height))
    if not all(map(math.isfinite, (x, y))) or not (0 <= x < width and 0 <= y < height):
        raise ControlError("simrig tap is outside the active display")
    # CoreDevice's external touchscreen consumes natural-display coordinates.
    # AX reports the rotated UI coordinates. Measured with actual Settings,
    # Swap and Terminal close state changes on the pooled Duo (WD-HINGE).
    if orientation == "Portrait Upside Down":
        x, y = natural_width - x, natural_height - y
    elif orientation == "Landscape Left":
        x, y = y, natural_height - x
    # A valid UI edge at zero rotates to the opposite boundary; keep it inside
    # the digitizer's half-open range without retargeting any off-screen point.
    x = min(x, math.nextafter(natural_width, 0))
    y = min(y, math.nextafter(natural_height, 0))
    # The display's position among the integrated displays (primary cover, primary-1 inner) picks its
    # built-in digitizer on runtimes that name none (Xcode 27.2).
    return x, y, natural_width, natural_height, ident, 0 if name == "primary" else 1


RIG_COMPILE_FLAGS = ("-target", "arm64-apple-ios17.0-simulator", "-DWONDER_SIMRIG_STANDALONE=1",
                     "-fobjc-arc", "-Wall", "-Werror", "-O1", "-framework", "Foundation", "-framework", "CoreFoundation")


def rig_build_plan(source):
    inputs = [source / "main.m", source / "rig.entitlements"]
    command = ["xcrun", "--sdk", "iphonesimulator", "clang", *RIG_COMPILE_FLAGS,
               str(inputs[0]), "-o", "OUTPUT", f"-Wl,-sectcreate,__TEXT,__entitlements,{inputs[1]}"]
    digest = hashlib.sha256(json.dumps(command).encode() + b"".join(p.read_bytes() for p in inputs)).hexdigest()[:16]
    binary = ROOT / ".local/build/simrig" / digest / "wonder-simrig"
    command[command.index("OUTPUT")] = str(binary)
    return digest, binary, command


def simrig(*args):
    """Build an isolated simulator executable; never load HID into this Mac process."""
    device = find_device()
    if not device or device["state"] != "Booted" or not device.get("deviceTypeIdentifier", "").startswith("com.apple.CoreSimulator.SimDeviceType."):
        raise ControlError("simrig requires this profile's booted CoreSimulator device")
    if args[0] in {"hinge", "orient"} and device["deviceTypeIdentifier"] != "com.apple.CoreSimulator.SimDeviceType.iPhone-Duo":
        raise ControlError("hinge/orientation requires the iPhone Duo simulator")
    if args[0] == "tap":
        inventory = simctl("io", device["udid"], "enumerate").stdout
        args = ("tap", *rig_tap(inventory, *args[1:5]))
    elif args[0] == "swipe":
        inventory = simctl("io", device["udid"], "enumerate").stdout
        x, y, end_x, end_y, width, height, duration = args[1:]
        start = rig_tap(inventory, x, y, width, height)
        end = rig_tap(inventory, end_x, end_y, width, height)
        args = ("swipe", *start[:2], *end[:2], *start[2:4], duration, *start[4:])
    source = ROOT / "apps/ios/control/rig"
    digest, binary, command = rig_build_plan(source)
    if not binary.exists():
        binary.parent.mkdir(parents=True, exist_ok=True)
        # Private entitlements in __TEXT only: launchd_sim rejects them in an ad-hoc signature.
        sh(command)
        sh(["codesign", "-s", "-", "--force", str(binary)])
    home = Path(simctl("getenv", device["udid"], "HOME").stdout.strip())
    # Only copy into this simulator's own tmp, never an arbitrary getenv path.
    expected = Path.home() / "Library/Developer/CoreSimulator/Devices" / device["udid"] / "data"
    if home.resolve() != expected.resolve():
        raise ControlError(f"simrig refused unexpected simulator HOME: {home}")
    destination = home / "tmp" / f"wonder-simrig-{digest}"
    if not destination.exists():
        shutil.copy2(binary, destination)
    result = simctl("spawn", device["udid"], str(destination), *map(str, args), timeout=120)
    print(result.stdout.strip())


