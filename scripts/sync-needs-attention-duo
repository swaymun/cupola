#!/usr/bin/env python3
"""Derive needs-attention-duo.wctl from needs-attention.wctl so the two cannot drift.

The Duo run differs only by its header (folded cover) and by opening More choices before
Allow always. Run without arguments to rewrite the Duo file; `--check` fails if it is stale.
"""
import pathlib, sys

root = pathlib.Path(__file__).resolve().parent.parent / "apps/ios/control/scenarios"
src = (root / "needs-attention.wctl").read_text().splitlines()
out = ["# devices: duo",
       "# GENERATED by scripts/sync-needs-attention-duo from needs-attention.wctl; edit that file.",
       "# The Duo's approval dock folds Allow always behind More choices.",
       "hinge 0", "orient portrait"]
for line in src[1:]:
    if line.startswith("# devices:") or line.startswith("# nightly-"):
        continue
    if line.startswith("tap --id approval-opencode:allow_always:"):
        out.append('tap --label "More choices"')
    out.append(line)
text = "\n".join(out) + "\n"
dest = root / "needs-attention-duo.wctl"
if "--check" in sys.argv:
    if dest.read_text() != text:
        sys.exit("needs-attention-duo.wctl is stale: run scripts/sync-needs-attention-duo")
else:
    dest.write_text(text)
