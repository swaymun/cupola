#!/usr/bin/env python3
"""Reject provider-name branches that decide a feature in the phone app.

Whether a provider offers a feature (Guide, Fork, goals, skills, plan, access
choices, usage, archive style, native sessions, attachments, prompt
suggestions...) comes from the Mac's ProviderCapabilities record
(apps/native/Sources/WonderPairing/ProviderCapabilities.swift). Its legacy
table is the only provider-keyed feature table on the phone.

A provider-name comparison or switch case is allowed only for identity:
icons, names, labels, default choices and per-provider storage or wire
compatibility. Mark such a line (or the line above it) with
`// provider identity`. Code inside `#if WONDER_DIAGNOSTICS` (fixtures that
never ship in Release) is not checked.

Run without arguments for the owned surfaces, or pass files for a focused check.
"""
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SURFACES = (
    "apps/ios/Wonder", "apps/ios/WonderShare", "apps/ios/WonderWidget",
    "apps/ios/PushShared", "apps/native/Sources/WonderPairing",
)
MARKER = "// provider identity"
# The legacy capability table, plus Diagnostics-only fixtures and recorders.
EXEMPT = (re.compile(r"^ProviderCapabilities\.swift$"), re.compile(r"^Diagnostic.*\.swift$"))
NAME = r"(?:codex|claude|opencode)"
PATTERNS = [
    re.compile(rf"[=!]=\s*(?:AgentFamily)?\.{NAME}\b"),          # x == .codex
    re.compile(rf"(?:AgentFamily)?\.{NAME}\s*[=!]="),             # .codex == x
    re.compile(rf"[=!]=\s*\"{NAME}\""),                           # x == "codex"
    re.compile(rf"\"{NAME}\"\s*[=!]="),
    re.compile(rf"\bcase\b[^:]*\.{NAME}\b"),                      # case .codex / if case .codex =
    re.compile(rf"\bcase\b[^:]*\"{NAME}\""),                      # case "codex"
    re.compile(rf"\.contains\(\s*\.{NAME}\b"),                    # set.contains(.codex)
    re.compile(rf"\[\s*\.{NAME}\s*,"),                            # [.codex, .claude] family lists
    re.compile(rf"\?\s*\.{NAME}\b"),                               # cond ? .codex : ...
    re.compile(r"\b(?:agentFamily|skillFamily)\([^)]*\)\s*[=!]="),
    re.compile(r"\bsupportsAccessChoices\b|\busageFamilies\b"),
]


def strip_comment(text):
    """Drop a trailing // comment that is not inside a string literal."""
    in_string = False
    for i, ch in enumerate(text):
        if ch == '"' and (i == 0 or text[i - 1] != "\\"):
            in_string = not in_string
        elif not in_string and text.startswith("//", i):
            return text[:i]
    return text


def check(path):
    if any(p.match(path.name) for p in EXEMPT):
        return []
    lines = path.read_text().splitlines()
    hits = []
    conditions = []  # one flag per open #if: True while in a Diagnostics-only branch
    for index, text in enumerate(lines):
        directive = text.strip()
        if directive.startswith("#if"):
            conditions.append(directive.split()[1:2] == ["WONDER_DIAGNOSTICS"])
            continue
        if directive.startswith(("#else", "#elseif")) and conditions:
            conditions[-1] = False
            continue
        if directive.startswith("#endif") and conditions:
            conditions.pop()
            continue
        if any(conditions):
            continue
        code = strip_comment(text)
        if not any(p.search(code) for p in PATTERNS):
            continue
        if MARKER in text or (index > 0 and MARKER in lines[index - 1]):
            continue
        hits.append(index + 1)
    return hits


def main():
    paths = [Path(p).resolve() for p in sys.argv[1:]] if len(sys.argv) > 1 else sorted(
        path for surface in SURFACES for path in (ROOT / surface).rglob("*.swift") if path.is_file()
    )
    failures = 0
    for path in paths:
        label = path.relative_to(ROOT) if path.is_relative_to(ROOT) else path
        for line in check(path):
            print(f"{label}:{line}: provider-name branch decides a feature; read ProviderCapabilities "
                  "(model.capabilities(chat).steer, projects.capabilities(family)) instead, "
                  f"or mark display-only lines with {MARKER}")
            failures += 1
    if failures:
        print(f"{failures} provider-name branch(es).", file=sys.stderr)
        return 1
    print(f"Provider branch check passed ({len(paths)} files).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
