#!/usr/bin/env python3
"""Run the isolated Mac SwiftUI package; never boots or changes a simulator."""
import argparse
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import subprocess
import sys
import threading
import time

ROOT = Path(__file__).resolve().parents[2]
SOURCE = ROOT / "apps/ios/Presentation/PreparedChatViews.swift"


def booted():
    result = subprocess.run(["xcrun", "simctl", "list", "devices", "booted", "--json"],
                            capture_output=True, text=True, check=True, timeout=10)
    return [device["udid"] for devices in json.loads(result.stdout)["devices"].values()
            for device in devices if device["state"] == "Booted"]


def run_suite(output, record=False, test_filter="PresentationSnapshotTests", require_no_simulator=False):
    if output.exists() and any(output.iterdir()):
        raise RuntimeError(f"Evidence directory already contains files; choose a fresh --output: {output}")
    output.mkdir(parents=True, exist_ok=True)
    samples, errors = [], []
    stopped = threading.Event()
    start = time.perf_counter()

    def sample():
        try:
            samples.append({"elapsed_seconds": round(time.perf_counter() - start, 3), "booted": booted()})
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            errors.append(str(error))

    def monitor():
        while not stopped.wait(1):
            sample()

    sample()
    if errors or (require_no_simulator and samples[-1]["booted"]):
        raise RuntimeError("No-simulator measurement requires zero booted simulators; no devices were changed")
    command = ["swift", "test", "--package-path", str(ROOT / "apps/ios"),
               "--scratch-path", str(ROOT / ".local/build/swiftui-snapshots"),
               "-c", "release", "-j", "4", "--disable-swift-testing", "--filter", test_filter]
    env = dict(os.environ, WONDER_SNAPSHOT_OUTPUT=str(output), WONDER_SNAPSHOT_RECORD="1" if record else "0")
    # The selected checkout owns this package/cache. No app identity or preferences are read.
    worker = threading.Thread(target=monitor, daemon=True)
    worker.start()
    try:
        with (output / "suite.log").open("w") as log:
            process = subprocess.run(command, cwd=ROOT, env=env, stdout=log, stderr=subprocess.STDOUT)
    finally:
        stopped.set()
        worker.join()
        sample()
    log = (output / "suite.log").read_text()
    counts = re.findall(r"Executed (\d+) tests?, with (\d+) failures?", log)
    count, failures = map(int, counts[-1]) if counts else (0, 0)
    snapshots = len(re.findall(r"^SNAPSHOT (?:compared|recorded) ", log, re.M))
    no_simulators = not errors and all(not item["booted"] for item in samples)
    passed = process.returncode == 0 and count > 0 and not errors and (not require_no_simulator or no_simulators)
    result = {
        "runner_exit_code": 0 if passed else 1,
        "command": command, "record": record, "exit_code": process.returncode,
        "wall_seconds": round(time.perf_counter() - start, 3),
        "tests": count, "failures": failures, "snapshots": snapshots,
        "zero_booted_simulators": no_simulators, "simulator_samples": samples, "monitor_errors": errors,
        "macOS": platform.mac_ver()[0], "architecture": platform.machine(),
        "xcode": subprocess.check_output(["xcodebuild", "-version"], text=True).strip(),
        "git_head": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip(),
        "presentation_sha256": hashlib.sha256(SOURCE.read_bytes()).hexdigest(),
        "test_sha256": hashlib.sha256((ROOT / "apps/ios/SnapshotTests/PresentationSnapshotTests.swift").read_bytes()).hexdigest(),
    }
    (output / "result.json").write_text(json.dumps(result, indent=2) + "\n")
    print(f"{'RECORD' if record else 'COMPARE'}: {count} tests, {failures} failures, {snapshots} images; "
          f"wall {result['wall_seconds']:.3f}s; zero booted simulators={no_simulators}; {output}", flush=True)
    if process.returncode or count == 0 or (require_no_simulator and not no_simulators):
        print("\n".join(log.splitlines()[-35:]), flush=True)
    return passed, result


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--record", action="store_true", help="Replace tracked references; review the image diff")
    modes.add_argument("--regression-demo", action="store_true", help="Prove pass → moved user bubble fails → restore passes")
    parser.add_argument("--require-no-simulator", action="store_true", help="Fail if any sampled simulator is booted; never shuts down another task")
    parser.add_argument("--filter", default="PresentationSnapshotTests")
    parser.add_argument("--output", type=Path, help="Evidence directory (default: .local/evidence/swiftui-snapshots/<UTC time>)")
    args = parser.parse_args()
    output = (args.output or ROOT / ".local/evidence/swiftui-snapshots" /
              datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S.%fZ")).resolve()
    if not args.regression_demo:
        passed, result = run_suite(output, args.record, args.filter, args.require_no_simulator)
        return 0 if passed else 1

    output.mkdir(parents=True, exist_ok=True)
    original = SOURCE.read_bytes()
    before, _ = run_suite(output / "before", require_no_simulator=args.require_no_simulator)
    if not before:
        return 1
    needle = b".frame(maxWidth: 640, alignment: isUser ? .trailing : .leading)"
    if original.count(needle) != 1:
        raise RuntimeError("Regression demo expected exactly one production bubble alignment owner")
    mutant = original.replace(needle, b".frame(maxWidth: 640, alignment: .leading)")
    (output / "mutation.patch").write_text(
        "--- apps/ios/Presentation/PreparedChatViews.swift\n+++ deliberate user-left regression\n"
        "-" + needle.decode() + "\n+.frame(maxWidth: 640, alignment: .leading)\n")
    try:
        SOURCE.write_bytes(mutant)
        mutation_passed, mutation = run_suite(output / "user-left", test_filter="testTimelineKeepsUserRightAgentLeftAndSpeakerSurfaces", require_no_simulator=args.require_no_simulator)
    finally:
        SOURCE.write_bytes(original)
    after, restored = run_suite(output / "restored", require_no_simulator=args.require_no_simulator)
    detected = not mutation_passed and mutation["tests"] == 1 and mutation["failures"] > 0 and mutation["snapshots"] == 4
    verified = before and detected and after and SOURCE.read_bytes() == original
    summary = {"verified": verified, "baseline_passed": before, "mutation_detected": detected,
               "restored_passed": after, "source_restored": SOURCE.read_bytes() == original,
               "mutation": mutation, "restored": restored}
    (output / "regression-demo.json").write_text(json.dumps(summary, indent=2) + "\n")
    print(f"REGRESSION DEMO: {'PASS' if verified else 'FAIL'}; production source restored={summary['source_restored']}")
    return 0 if verified else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (RuntimeError, subprocess.SubprocessError) as error:
        print(f"snapshot-tests: {error}", file=sys.stderr)
        sys.exit(1)
