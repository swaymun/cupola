# devices: duo
# Per-chat notifications on the unfolded Duo. Run with wonderctl run --input rig;
# every tap asserts the resulting native menu, saved choice or rollback.
hinge 180
orient portrait
driver on
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture project-speed --fixture send-states --fixture open-project-thread --fixture notify-fixture --fixture notify-fail-mute
assert --path thread.id --equals '"fixture-parent-conversation"' --timeout 30
driver off
tap --id conversation-title-menu
wait --label "Notifications: Default" --timeout 10
tap --label "Notifications: Default"
wait --label "Follow" --timeout 10
wait --label "Default" --timeout 5
wait --label "Mute" --timeout 5
shot chat-notify-unfolded-menu --display primary-1
# Follow is kept: the header shows a bell.
tap --label "Follow"
wait --id header-notification-follow --timeout 10
shot chat-notify-unfolded-followed --display primary-1
# Mute is refused by the computer: the old choice returns and the message says why.
tap --id conversation-title-menu
wait --label "Notifications: Follow" --timeout 10
tap --label "Notifications: Follow"
wait --label "Mute" --timeout 10
tap --label "Mute"
wait --id chat-notice --contains "Still Follow" --timeout 10
wait --id header-notification-follow --timeout 10
assert --id header-notification-mute --gone
shot chat-notify-unfolded-rolled-back --display primary-1
# The Chats row shows the same bell, with its own spoken label.
sidebar open
wait --id sidebar-notification --timeout 10
shot chat-notify-unfolded-sidebar --display primary-1
