# devices: duo
# Real AppShell, each pane owner, split and a restored expanded preference.
# Duo keeps both physical displays usable; it has no spread-wide expand action.
# Native AX and inner-display capture-rail.py own geometry; no Duo native tap claim (#387).
# Pull requests has no rail pill (the chat's title menu opens it), so its pane keeps Close.
# No model sends or paired host. See capture-rail.py --state pane-<tool>[-expanded].
hinge 180
orient portrait
driver on
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture terminal-available --fixture project-files-send --fixture open-project-thread --fixture rail-fixture --fixture context-usage --fixture project-pull-requests --arg=-diagnostics-companion-pull-requests --arg=-wonder.sidebar.hidden --arg=YES --arg=-composerPills --arg=computer,files,terminal,preview,attention,goal,agentTasks,git
assert --path pane.tool --equals '"pull-requests"' --timeout 30
assert --path pane.expanded --equals false --timeout 10
driver off
wait --id companion-pane-header --timeout 20
wait --id companion-pane-expand --gone --timeout 10
wait --id companion-pane-flip --timeout 10
wait --id pull-requests-done --timeout 10
wait --id open-sidebar --timeout 10
wait --id context-usage-ring --timeout 10
driver on
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture terminal-available --fixture project-files-send --fixture open-project-thread --fixture rail-fixture --fixture context-usage --fixture project-pull-requests --arg=-diagnostics-companion-pull-requests --arg=-diagnostics-companion-expanded --arg=-wonder.sidebar.hidden --arg=YES --arg=-composerPills --arg=computer,files,terminal,preview,attention,goal,agentTasks,git
