wait --id companion-pane-flip --timeout 10
wait --id reply-changes-done --timeout 10
wait --id open-sidebar --timeout 10
wait --id context-usage-ring --timeout 10
# Preview is a full-screen route after W2-BROWSER-ONE. Close the expanded
# fixture pane through its production dismiss action, then prove Preview's
# own Done returns to the same chat. The eight states above use AppShell;
# this older WebKit fixture owns its preview root. No external links or sends.
driver on
dismiss
assert --path pane --equals null --timeout 10
launch --fixture read-preview --fixture send-preview --fixture project-files-conversation-preview --fixture dev-server-preview --fixture context-usage --arg=-wonder.sidebar.hidden --arg=YES
tap --id preview-pages-menu
tap --id preview-page-5173
wait --id browser-preview-page-probe --contains "Recipes · " --timeout 15
assert --path browser.fullScreen --equals true
tap --id browser-done
assert --path browser --equals null --timeout 10
assert --path thread.id --equals '"preview"'
assert --path pane --equals null
driver off
wait --id message-draft --timeout 10
# The preview fixture has no provider reading, and the context ring is offered only once one is measured
# (UX-HEADER-POLISH: Usage beside Settings is the plan entry), so the ring stays away.
wait --id context-usage-ring --gone --timeout 10
hinge 0
orient portrait
