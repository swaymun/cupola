# Duo only; outside the feature map until #387 closes. Offline transport only.
# Contract: unfold from the chat, then open Computer in the regular-width
# companion pane, with both the viewer and the chat composer still usable.
# Diagnostics driver invokes the same Computer pill action; AXe taps on the
# Duo can report success without opening it (#387). Viewer checks still use AXe.
# Launch first so hinge 0 never closes over Home (which can sleep the cover).
# `shot` captures the cover. While unfolded, the verifier must also capture
# simctl io UDID screenshot --display=primary-1 FILE and retain the launch PID.
driver on
launch --fixture read-preview --fixture send-preview --fixture computer-session-available-fixture --fixture computer-menu-fixture --fixture computer-simulator-fixture --arg=-composerPills --arg=computer --arg=-wonder.companionPane.flipped --arg=NO --arg=-wonder.companionPane.fraction.portrait --arg=0.5 --arg=-wonder.companionPane.fraction.landscape --arg=0.5
hinge 0
orient portrait
wait --id computer-status-pill --timeout 30
shot duo-b-folded-chat
hinge 180
orient portrait
wait --id computer-status-pill --timeout 15
driver off
wait --id message-draft --timeout 15
shot duo-b-unfolded-chat
driver on
tap --id computer-status-pill
driver off
wait --id companion-pane --timeout 15
wait --id computer-session-connection-picker --timeout 15
wait --id computer-session-preview --contains "Live" --timeout 15
wait --id message-draft --timeout 10
shot duo-b-unfolded-computer
driver on
tap --id computer-status-pill
driver off
wait --id companion-pane --gone --timeout 10
wait --id message-draft --timeout 10
shot duo-b-unfolded-chat-closed
hinge 0
orient portrait
driver on
wait --id computer-status-pill --timeout 15
