# devices: iphone-11-usb
# Physical iPhone 11 only (scripts/device-runner): the simulator lanes skip it as not applicable.
# RESCUE-VERIFY live restart limit on the USB iPhone 11, paired to a scratch host.
# The host's daemon is killed until its supervisor gives up and the restart
# allowance (three per ten minutes, all devices together) is already spent, so
# Restart is refused and the phone says when to try again. Run it again after the
# window: the same tap then restarts Cupola and the notice goes away.
launch
wait --id open-sidebar --timeout 60
sidebar open
wait --id chats-sidebar --timeout 20
wait --id sidebar-rescue-restart --timeout 280
shot rv-limit-gave-up
tap --id sidebar-rescue-restart
wait --contains "Try again in" --timeout 30
shot rv-limit-refused
