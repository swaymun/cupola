# devices: duo
# The Usage page lists every paired computer's provider limits: % left, a bar,
# pace (ahead of / under) and the reset countdown. Fixtures put resets two hours
# (5 hours window) and three days (weekly) out so the countdown and pace are live.
# Folded (hinge 0, portrait cover) then unfolded (hinge 180); inner shots use primary-1.
# Folded: the sidebar and the page are opened by launch flags (Duo taps are gated, #387); the tap path is checked on iPhone and iPad.
hinge 0
orient portrait

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-live-reset --fixture theme --arg cupola-light --fixture sidebar-open
wait --id sidebar-usage --timeout 30
shot a-usage-duo-folded-light-sidebar

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-live-reset --fixture theme --arg cupola-light --fixture usage-open
wait --id usage-page --timeout 30
wait --id codex-usage-window:five-hours --contains "under pace" --timeout 15
shot a-usage-duo-folded-light-one

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture several-computers --fixture theme --arg cupola-light --fixture usage-open
wait --id usage-page --timeout 30
wait --id codex-usage-window:primary --contains "73% left" --timeout 15
shot a-usage-duo-folded-light-several

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-exhausted --fixture usage-live-reset --fixture theme --arg cupola-light --fixture usage-open
wait --id usage-page --timeout 30
wait --id codex-usage-window:five-hours --contains "0% left" --timeout 15
shot a-usage-duo-folded-light-exhausted

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-empty --fixture theme --arg cupola-light --fixture usage-open
wait --id usage-page --timeout 30
shot a-usage-duo-folded-light-empty

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-ahead --fixture theme --arg cupola-light --fixture usage-open
wait --id usage-page --timeout 30
wait --id codex-usage-window:five-hours --contains "ahead of pace" --timeout 15
shot a-usage-duo-folded-light-ahead

launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture usage-fixture --fixture usage-live-reset --fixture theme --arg cupola-dark --fixture sidebar-open
