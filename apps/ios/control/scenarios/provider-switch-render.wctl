# devices: iphone ipad
# PROVIDER-SWITCH-RENDER: a T3 thread that changed provider (replies 1-6 recorded by T3 Code as
# claudeAgent, 7-12 as opencode) names the provider at the first reply of each run; a thread that
# never switched shows no provider label. Offline fixture; nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture opencode-fixture --fixture t3-provider-switch
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:opencode:read-fixture --timeout 20
tap --id pinned-thread:opencode:read-fixture
wait --contains "Reply 12. The update is ready." --timeout 20
wait --contains "OpenCode: Reply 12." --timeout 10
shot provider-switch-render-latest
swipe down --in conversation-scroll
swipe down --in conversation-scroll
swipe down --in conversation-scroll
swipe down --in conversation-scroll
swipe down --in conversation-scroll
swipe down --in conversation-scroll
wait --id message-provider --contains "Claude" --timeout 10
wait --contains "Claude: Reply 1." --timeout 10
shot provider-switch-render-earlier
# Unchanged thread: same fixture without the switch records no label.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture opencode-fixture
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:opencode:read-fixture --timeout 20
tap --id pinned-thread:opencode:read-fixture
wait --contains "Reply 12. The update is ready." --timeout 20
wait --id message-provider --gone --timeout 5
shot provider-switch-render-unswitched
