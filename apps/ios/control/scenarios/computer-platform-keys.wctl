wait --id computer-session-input-limitation --gone
shot computer-platform-linux-control
tap --id computer-session-shortcut-app-switcher
wait --id computer-session-shortcut-app-switcher --contains "Open, Alt held"
swipe left --in computer-session-shortcuts-row
tap --id computer-session-key-tab
wait --id computer-session-shortcut-app-switcher --contains "Open, Alt held"
shot computer-platform-linux-switcher
swipe right --in computer-session-shortcuts-row
tap --id computer-session-key-escape
wait --id computer-session-shortcut-app-switcher --contains Closed
tap --id computer-session-shortcut-activities
swipe left --in computer-session-shortcuts-row
tap --id computer-session-shortcut-right-click
swipe right --in computer-session-shortcuts-row
tap --id computer-session-shortcut-super
wait --id computer-session-shortcut-super --contains "Selected for next key"
swipe left --in computer-session-shortcuts-row
tap --id computer-session-key-tab
swipe right --in computer-session-shortcuts-row
wait --id computer-session-shortcut-super --contains "Selected for next key" --gone
wait --id computer-session-shortcut-super
tap --id computer-session-done
wait --id computer-session-take-control --timeout 15
