# devices: iphone ipad
# Owned offline transport fixture; values are never put in scenario logs.
# The Save/Keychain/ref contract is exercised by wonderd's signed phone test.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture open-project-thread --fixture vault --fixture vault-prompt --fixture theme --arg light-classic
wait --id secret-label --timeout 30
wait --contains "Check the token’s length"
wait --id secret-field
wait --id secret-save
wait --id secret-cancel
shot vault-prompt
tap --id secret-cancel
wait --id secret-field --gone --timeout 15
wait --id question-dock-open --gone --timeout 15
shot vault-cancelled
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture vault --fixture vault-settings --fixture theme --arg light-classic
wait --id saved-secret:TEST_TOKEN --timeout 30
wait --contains "Weekend project"
wait --contains "Claude"
wait --contains "Codex"
shot vault-settings
swipe left --in saved-secret:TEST_TOKEN
wait --id secret-delete:TEST_TOKEN --timeout 15
tap --id secret-delete:TEST_TOKEN
wait --id secret-delete-confirm --timeout 15
shot vault-delete-confirm
tap --id secret-delete-confirm
wait --id secrets-empty --timeout 15
wait --id saved-secret:TEST_TOKEN --gone
shot vault-deleted
