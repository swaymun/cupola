launch --fixture read-preview --fixture send-preview --fixture project-files-conversation-preview --fixture project-git-preview --fixture terminal-preview --fixture computer-session-available-fixture --arg=-composerPills --arg=computer,files,terminal --fixture theme --arg cupola-dark --arg=-diagnostics-companion-files --arg=-preview-document --arg=README.md
assert --path pane.tool --equals '"files"' --timeout 30
assert --id conversation-files-pill --contains "Open" --timeout 10
shot a-duo-split-unfolded-preview-open-cupola-dark --display primary-1
tap --id conversation-files-pill
assert --path pane --equals null --timeout 10
assert --id conversation-files-pill --contains "Closed" --timeout 10
driver off
wait --id companion-pane --gone --timeout 10
shot a-duo-split-unfolded-preview-closed-cupola-dark --display primary-1

