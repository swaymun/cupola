# unfolded-close / cupola-light / files
hinge 180
orient portrait
driver on
launch --fixture read-preview --fixture send-preview --fixture project-files-conversation-preview --fixture project-git-preview --fixture terminal-preview --fixture computer-session-available-fixture --arg=-composerPills --arg=computer,files,terminal --fixture theme --arg cupola-light --arg=-diagnostics-companion-files
assert --path pane.tool --equals '"files"' --timeout 30
assert --id conversation-files-pill --contains "Open" --timeout 10
shot a-duo-split-unfolded-files-open-cupola-light --display primary-1
tap --id conversation-files-pill
assert --path pane --equals null --timeout 10
assert --id conversation-files-pill --contains "Closed" --timeout 10
driver off
wait --id companion-pane --gone --timeout 10
shot a-duo-split-unfolded-files-closed-cupola-light --display primary-1
