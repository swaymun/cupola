# narrow-320-drawer / cupola-light
driver on
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-files-send --fixture project-pull-requests --fixture project-subagents --fixture terminal-available --fixture open-project-thread --fixture rail-fixture --fixture theme --arg cupola-light --arg=-diagnostics-window-width --arg=320 --arg=-wonder.sidebar.hidden --arg=YES
assert --path thread.id --equals '"fixture-parent-conversation"' --timeout 30
tap --id open-sidebar
assert --path sidebarOpen --equals true --timeout 10
driver off
wait --id sidebar-new-chat --timeout 15
shot a-duo-split-narrow-320-drawer-cupola-light --display primary-1

