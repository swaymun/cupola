# folded / nord: finished turn, folded then expanded
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture turn-collapse --fixture theme --arg nord --fixture open-project-thread
wait --contains "One file changed" --timeout 15
shot a-worked-for-folded-nord-finished-folded
# folded / nord: running turn mid-step, then finished
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture project-claude-tasks --fixture current-step --fixture current-step-finishes --fixture theme --arg nord --fixture open-project-thread
