# devices: duo
# A-WORKED-FOR captures on the Duo (no expand tap: Duo touch input is not qualified, #387; iPhone/iPad cover it): folded cover, then the unfolded inner display. Offline fixtures; nothing is sent.
hinge 0
orient portrait
# folded / cupola-light: finished turn, folded then expanded
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture turn-collapse --fixture theme --arg cupola-light --fixture open-project-thread
wait --contains "One file changed" --timeout 15
shot a-worked-for-folded-cupola-light-finished-folded
# folded / cupola-light: running turn mid-step, then finished
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture project-claude-tasks --fixture current-step --fixture current-step-finishes --fixture theme --arg cupola-light --fixture open-project-thread
wait --id conversation-title-menu --contains "Searching for isWorking" --timeout 15
shot a-worked-for-folded-cupola-light-running
signal current-step-finish
wait --contains "Searching for isWorking" --gone --timeout 30
shot a-worked-for-folded-cupola-light-current-step-finish
# folded / cupola-light: stopped turn
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture thinking-elapsed --fixture thinking-stopped --fixture open-project-thread --fixture theme --arg cupola-light --fixture open-project-thread
wait --contains "The layout keeps the message composer available." --timeout 30
shot a-worked-for-folded-cupola-light-stopped
# folded / cupola-light: agent tasks finished
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-provider-switch --fixture theme --arg cupola-light --fixture open-project-thread
wait --id agent-tasks-finished --timeout 20
shot a-worked-for-folded-cupola-light-tasks-finished

# folded / cupola-dark: finished turn, folded then expanded
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture turn-collapse --fixture theme --arg cupola-dark --fixture open-project-thread
