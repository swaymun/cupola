wait --contains "The layout keeps the message composer available." --timeout 30
shot a-worked-for-folded-cupola-dark-stopped
# folded / cupola-dark: agent tasks finished
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-provider-switch --fixture theme --arg cupola-dark --fixture open-project-thread
