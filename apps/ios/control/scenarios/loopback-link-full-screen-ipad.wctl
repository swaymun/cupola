# devices: ipad
# nightly-ipad: native localhost link opens full screen and Done returns to chat
# visual-review: native localhost link, page menu, desktop site, full-screen Done
# iPad Pro 11-inch portrait at Large text. The grouped reply AX frame spans
# the row; its midpoint is not the link. 232,255 is inside localhost:5173
# in the actual capture. The iPhone scenario uses its own captured hit target.
driver on
launch --fixture read-preview --fixture send-preview --fixture project-files-conversation-preview --fixture dev-server-preview --arg=-UIPreferredContentSizeCategoryName --arg=UICTContentSizeCategoryL --arg=-composerPills --arg=computer,files,preview
driver off
wait --id preview-pages-menu --timeout 20
wait --contains "The planner is at" --timeout 10
shot browser-native-reply
tap --xy 232,255
wait --id browser-preview-page-probe --contains "Recipes · " --timeout 15
driver on
assert --path browser.fullScreen --equals true
assert --path browser.url --equals '"wonder-preview://port-5173/?view=plan"'
assert --path openedLinks.0.opening --equals '"computer"'
driver off
shot browser-native-localhost
tap --id browser-share
wait --label "Request desktop site" --timeout 5
tap --label "Request desktop site"
wait --id browser-preview-page-probe --label "Recipes · 1280 px wide" --timeout 15
shot browser-native-desktop
tap --id browser-share
wait --label "Request mobile site" --timeout 5
tap --label "Request mobile site"
wait --id browser-preview-page-probe --label "Recipes · 1280 px wide" --gone --timeout 15
tap --id browser-done
wait --id message-draft --timeout 10
driver on
assert --path browser --equals null
assert --path presented --equals '[]' --timeout 10
assert --path composer.text --equals '"Keep the evening free too."'
driver off
# The globe opens only the small native page menu, including its refresh action.
tap --id preview-pages-menu
wait --label "Check for pages" --timeout 5
shot browser-native-page-menu
tap --label "Check for pages"
wait --id message-draft --timeout 10
shot browser-native-returned
