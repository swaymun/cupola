# A prompt written in Codex or Claude on the Mac keeps the image attached to it on the
# user's bubble. The host stores the transcript's image as a verified file and lists
# it on the item (claude-runtime and wonderd retention tests); the fixture serves
# history and the file as the host now projects them. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --contains "Continue the project at:" --timeout 20
# The Mac prompt sits just above the newest turns.
swipe down
wait --contains "From the Mac: what changed in this screenshot?" --timeout 10
wait --id message-attachment-open:desktop-screenshot --contains Loaded --timeout 15
shot desktop-image
