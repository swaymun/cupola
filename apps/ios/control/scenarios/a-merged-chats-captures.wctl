# devices: iphone ipad
# Merged Chats and Projects across computers; Manage Projects once. Offline fixtures only, no sends.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture several-computers --fixture theme --arg cupola-light
wait --id open-sidebar --timeout 30
sidebar open
wait --id sidebar-search --timeout 30
shot a-merged-chats-mobile-cupola-light-projects-several

