# A Claude thread whose turns write notes between tool calls, as Claude Code
# records them. Finished turns show the owner's message, one collapsed Working
# group and only the last reply; the notes are inside the group. A turn whose
# answer is followed by a tool still shows that answer; an interrupted turn
# with no answer shows only its work. Offline fixture; nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture turn-collapse
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:claude:read-fixture --timeout 20
tap --id pinned-thread:claude:read-fixture
wait --contains "One file changed" --timeout 15
wait --contains "Reading the diff." --gone --timeout 5
reveal down --contains "Fixed: the header keeps its title"
wait --contains "The tests pass." --gone --timeout 5
wait --contains "Found it: the title is rebuilt" --gone --timeout 5
# One "Worked for" fold per finished turn, collapsed, with the turn's recorded time.
wait --id activity-group:collapse-turn-1/collapse-turn-1-text-0 --contains "Worked for 1m 12s" --timeout 5
wait --id activity-group:collapse-turn-1/collapse-turn-1-text-0 --contains "Collapsed" --timeout 5
shot turn-collapse-folded
tap --id activity-group:collapse-turn-1/collapse-turn-1-text-0
wait --contains "Found it: the title is rebuilt" --timeout 5
wait --contains "The tests pass." --timeout 5
shot turn-collapse-expanded
