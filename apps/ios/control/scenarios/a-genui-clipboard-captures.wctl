tap --id computer-session-more
wait --id computer-session-share-clipboard
tap --id computer-session-share-clipboard
shot a-genui-clipboard-computer-unavailable-nord-toggled
launch --fixture computer-session-fixture --fixture computer-session-available-fixture --fixture theme --arg nord
wait --id computer-session-take-control --timeout 30
tap --id computer-session-take-control
wait --id computer-session-control-active --timeout 15
wait --id computer-session-clipboard-message --gone --timeout 5
shot a-genui-clipboard-computer-on-nord-open
# The clipboard lives on the keyboard's shortcut row.
tap --id computer-session-keyboard
wait --id computer-session-clipboard --timeout 10
tap --id computer-session-clipboard
tap --id computer-session-copy-from-mac
wait --id computer-session-clipboard-message --contains "Copied from" --timeout 5
shot a-genui-clipboard-computer-copied-nord-after-copy
launch --fixture computer-session-fixture --fixture computer-session-available-fixture --fixture computer-clipboard-off --fixture theme --arg misty-forest
wait --id computer-session-take-control --timeout 30
wait --id computer-session-clipboard-message --gone --timeout 5
shot a-genui-clipboard-computer-idle-misty-forest-open
tap --id computer-session-more
wait --id computer-session-share-clipboard
tap --id computer-session-share-clipboard
shot a-genui-clipboard-computer-unavailable-misty-forest-toggled
launch --fixture computer-session-fixture --fixture computer-session-available-fixture --fixture theme --arg misty-forest
wait --id computer-session-take-control --timeout 30
tap --id computer-session-take-control
wait --id computer-session-control-active --timeout 15
wait --id computer-session-clipboard-message --gone --timeout 5
shot a-genui-clipboard-computer-on-misty-forest-open
# The clipboard lives on the keyboard's shortcut row.
tap --id computer-session-keyboard
wait --id computer-session-clipboard --timeout 10
tap --id computer-session-clipboard
tap --id computer-session-copy-from-mac
