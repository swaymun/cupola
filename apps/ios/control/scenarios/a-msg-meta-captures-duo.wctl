# devices: duo
# A-MSG-META captures on the Duo, folded then unfolded. Offline fixtures; nothing is sent.
hinge 0
orient portrait
# folded / cupola-light: finished reply (time + Copy), streaming reply (none), long-press menu
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture open-project-thread --fixture theme --arg cupola-light
wait --contains "Reply 12. The update is ready." --timeout 20
shot a-msg-meta-folded-cupola-light-finished
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture send-states --fixture send-running --fixture stream-reply --fixture open-project-thread --fixture theme --arg cupola-light
wait --contains "Streaming reply, part one." --timeout 15
wait --contains "part ten." --never 1
shot a-msg-meta-folded-cupola-light-streaming
signal stream
wait --contains "part ten." --timeout 15
shot a-msg-meta-folded-cupola-light-streamed

