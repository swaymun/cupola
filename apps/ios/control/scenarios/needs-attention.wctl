# devices: iphone ipad
# nightly-ipad: native Needs you dropdown, exact request, confirmed removal, deep link.
# Owned offline fixture validates the approval; no provider or real chat is used.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture opencode-fixture --fixture opencode-approval --fixture question-resolution --fixture theme --arg cupola-light
wait --id open-sidebar --timeout 30
sidebar open
wait --id sidebar-needs-you --contains "2 requests" --timeout 20
shot needs-you-sidebar
tap --id sidebar-needs-you
wait --id needs-you:diagnostic-host:fixture-opencode-approval
# The bell stays in Chats; its native dropdown contains plain-language requests.
wait --contains "Approve an action"
wait --contains "Answer a question"
wait --contains "Project Studio" --gone --timeout 1
wait --contains "Project unavailable" --gone --timeout 1
shot needs-you-list
# The second request must open its own form, not the first approval in this chat.
tap --id needs-you:diagnostic-host:fixture-question
wait --contains "Which day works best?"
shot needs-you-exact-question
tap --label Skip --type Button
sidebar open
wait --id sidebar-needs-you --contains "1 request"
tap --id sidebar-needs-you
tap --id needs-you:diagnostic-host:fixture-opencode-approval
wait --id approval-accept-fixture-opencode-approval
shot needs-you-exact-request
# This fixture deliberately rejects Allow once; show its failed reply in the inbox.
tap --id approval-accept-fixture-opencode-approval
wait --contains "Action failed"
sidebar open
tap --id sidebar-needs-you
wait --contains "Reply didn’t send"
shot needs-you-failed-reply
tap --id needs-you:diagnostic-host:fixture-opencode-approval
tap --id approval-opencode:allow_always:fixture-always-allow-fixture-opencode-approval
wait --id approval-accept-fixture-opencode-approval --gone --timeout 20
sidebar open
# Nothing waiting: the bell is gone.
wait --id sidebar-needs-you --gone --timeout 10
wait --id needs-you-list --gone --timeout 3
shot needs-you-cleared
# Every paired computer contributes, even when another computer is selected.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture opencode-fixture --fixture opencode-approval --arg=-diagnostics-several-computers --arg=-diagnostics-deep-link --arg=wonder://v1/attention --fixture theme --arg cupola-light
wait --id needs-you:diagnostic-host-studio:fixture-opencode-approval --timeout 30
wait --id needs-you:diagnostic-host:fixture-opencode-approval
shot needs-you-all-computers
# A second computer's row opens that computer's chat at its request, not the current computer's.
tap --id needs-you:diagnostic-host-studio:fixture-opencode-approval
wait --id approval-accept-fixture-opencode-approval --timeout 30
wait --contains "Studio"
shot needs-you-second-computer-request
# Selecting one computer in Chats must not narrow the shared inbox.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture opencode-fixture --fixture opencode-approval --fixture several-computers --fixture sidebar-open --fixture theme --arg cupola-light
wait --id computer-filter:diagnostic-host --timeout 30
tap --id computer-filter:diagnostic-host
wait --id sidebar-needs-you --contains "2 requests"
tap --id sidebar-needs-you
wait --id needs-you:diagnostic-host-studio:fixture-opencode-approval
# The bell said 2 requests: the dropdown lists both, one per computer.
wait --id needs-you:diagnostic-host:fixture-opencode-approval
shot needs-you-independent-of-computer-filter
# Choosing chats swaps the bell for Select All; leaving selection brings the bell back.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture bulk-archive --fixture opencode-fixture --fixture opencode-approval --fixture theme --arg cupola-light
wait --id open-sidebar --timeout 30
sidebar open
wait --id sidebar-needs-you --timeout 20
shot sidebar-header-normal
hold --id pinned-thread:codex:bulk-1
tap --id select-project-thread
wait --id threads-select-all
wait --id sidebar-needs-you --gone
shot sidebar-header-selecting
tap --id threads-selection-cancel
wait --id sidebar-needs-you
wait --id threads-select-all --gone
