# devices: iphone ipad
# A thread T3 Code holds lists its delegate children in its Agent tasks, not in
# Chats: the Chats list shows the parent and no row for any child, except a
# child whose chat T3 Code no longer has, which is listed and marked Subagent.
# The fixture stands in for the Mac, so the host filter that leaves children of
# a known chat out of the thread list is proven by the daemon tests, not here:
# the "never" lines below only catch the phone listing task rows as chats.
# No model work.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture project-t3-tasks
wait --id open-sidebar --timeout 30
sidebar open
wait --id project-row:read-project --timeout 20
wait --id pinned-thread:codex:read-fixture --timeout 10
wait --id project-thread:claude:t3-orphan-fixture --timeout 10
wait --id project-thread:claude:t3-orphan-fixture --contains "Subagent" --timeout 5
wait --contains "Duo feedback videos" --never 2
wait --contains "Check the release notes" --never 2
wait --contains "Archive the old captures" --never 2
shot t3-subagent-nest-chats

# The same children are in the parent's Agent tasks.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-subagents --fixture project-t3-tasks --fixture open-project-thread
wait --id project-subagent-status-pill --timeout 30
tap --id project-subagent-status-pill
wait --id project-subagent-roster:t3-child-duo-videos --timeout 10
wait --id project-subagent-roster:t3-child-running --timeout 5
wait --id project-subagent-roster:t3-child-unreadable --timeout 5
wait --contains "Check the release notes, subagent, Running on your computer" --timeout 5
shot t3-subagent-nest-tasks
