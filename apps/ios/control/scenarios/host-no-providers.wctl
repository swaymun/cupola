# Settings > computer (and its Codex page) on a computer that has no provider list at all
# (a much earlier Cupola answers "not found"): the page says "Update Cupola on
# <Mac>: brew upgrade --cask cupola", with no "couldn't read" or "isn't set up"
# text. Host response fixture only: nothing is installed and nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture host-no-providers
wait --id open-sidebar --timeout 30
sidebar open
wait --id sidebar-settings --timeout 10
tap --id sidebar-settings
wait --id settings-computer:diagnostic-host --timeout 10
tap --id settings-computer:diagnostic-host
wait --id connection-rename --timeout 10
wait --id host-update-note --contains "brew upgrade --cask cupola" --timeout 15
reveal up --id settings-provider:codex --in connection-settings
tap --id settings-provider:codex
wait --id provider-status-unavailable --timeout 5
wait --id providers-failure --gone --timeout 2
shot host-no-providers
