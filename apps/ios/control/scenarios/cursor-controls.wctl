# Synthetic Cursor Project: native permissions, model choices and Plan.
# No provider session or model work is started.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture cursor-fixture --fixture open-project-thread --fixture theme --arg nord
wait --id project-composer-access --contains "Cursor settings" --timeout 20
wait --id project-composer-model --contains "Auto fixture" --timeout 10
wait --id project-composer-effort --gone --timeout 2
shot cursor-conversation
# Nothing measured: no ring in the header.
wait --id context-usage-ring --gone --timeout 5
tap --id project-composer-access
wait --contains "Cursor settings"
wait --id access-choice-readOnly --gone --timeout 2
wait --id access-choice-fullAccess --gone --timeout 2
shot cursor-access
tap --xy 200,300
tap --id project-composer-model
wait --id project-model:cursor:luna[reasoning=medium] --timeout 10
shot cursor-models
tap --id project-model:cursor:luna[reasoning=medium]
wait --id project-composer-model --contains "Luna fixture" --timeout 10
wait --id project-model:cursor:luna[reasoning=medium] --gone --timeout 5
tap --id project-composer-access
wait --id access-choice-plan --timeout 5
tap --id access-choice-plan
wait --id plan-mode-chip --timeout 10
wait --id project-composer-access --contains "Cursor settings"
shot cursor-plan
tap --id plan-mode-chip
wait --id plan-mode-chip --gone --timeout 10
wait --id project-composer-model --contains "Luna fixture"
shot cursor-saved
