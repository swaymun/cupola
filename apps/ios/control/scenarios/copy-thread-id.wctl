# Long-press a Codex Project thread: Copy thread ID puts Codex's own thread ID on
# the pasteboard (no folder path there any more). Long-press its Project: Copy
# folder path puts the Project's folder there. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture sidebar-status
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:codex:read-fixture --timeout 20
clipboard --clear
hold --id pinned-thread:codex:read-fixture
wait --id copy-thread-id --timeout 10
wait --label "Copy thread ID"
wait --id copy-thread-folder --gone
shot copy-thread-id-menu
tap --id copy-thread-id
clipboard --contains "read-fixture"
clipboard --not-contains "codex:"
# A Claude Code thread names its session.
hold --id project-thread:claude:7d1c9e42-5b3a-4f60-8e21-0a9b8c7d6e54
wait --label "Copy session ID" --timeout 10
tap --id copy-thread-id
clipboard --contains "7d1c9e42-5b3a-4f60-8e21-0a9b8c7d6e54"
clipboard --clear
hold --id project-row:read-project
wait --id copy-project-folder --timeout 10
shot copy-project-folder-menu
tap --id copy-project-folder
clipboard --contains "/fixture"
clipboard --show
