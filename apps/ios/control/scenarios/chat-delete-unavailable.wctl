# devices: iphone ipad
# visual-review: A computer whose Cupola can't delete chats shows Archive but no
# Delete in the chat's title menu; nothing is dimmed in its place.
# Owned transport only. No provider sends or production history deletion.
driver on
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture project-speed --fixture send-states --fixture open-project-thread --fixture chat-notice-held --arg=-diagnostics-delete-unsupported
assert --path thread.id --equals '"fixture-parent-conversation"' --timeout 30
driver off
tap --id conversation-title-menu
wait --id archive-conversation --timeout 10
assert --id delete-conversation --gone
shot chat-delete-unavailable-menu
