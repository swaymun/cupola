# devices: iphone
# SCROLL-BUTTON-TAP: scroll-to-end sits above the composer's pill row (Terminal among them). Taps on the arrow's
# edges and just outside it must never open the Terminal or Agent tasks; only the arrow scrolls.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture open-project-thread --fixture long-thread-title --fixture theme --arg cupola-dark --arg=-diagnostics-scroll-top --arg=-diagnostics-terminal-available --arg=-composerPills --arg=computer,files,terminal
wait --id conversation-title-menu --timeout 30
wait --id scroll-to-bottom --timeout 30
wait --id conversation-terminal-pill --timeout 10
tree --json
shot arrow-tap-neighbours-before
# Arrow {179,626 44x44}; Terminal pill {155,686 46x44}: 16 pt apart vertically, 22 pt of horizontal overlap.
# Just outside the arrow (below, left, right, in the gap above Terminal): nothing opens, the arrow stays.
tap --xy 190,675 --size 402,874
tap --xy 195,682 --size 402,874
tap --xy 176,648 --size 402,874
tap --xy 226,648 --size 402,874
wait --id terminal-sheet --gone --timeout 3
wait --label "Agent tasks" --gone --timeout 3
wait --id scroll-to-bottom --timeout 5
shot arrow-tap-neighbours-outside
# The arrow's circle at its lower-left edge, nearest Terminal (the corner of its 44 pt square is not part of the
# circle): scrolls, opens nothing.
tap --xy 187,663 --size 402,874
wait --id scroll-to-bottom --gone --timeout 10
wait --id terminal-sheet --gone --timeout 3
wait --label "Agent tasks" --gone --timeout 3
shot arrow-tap-neighbours-after
# Control: the same x, on Terminal itself, does open it (the taps above could have reached it).
tap --xy 190,712 --size 402,874
wait --id terminal-sheet --timeout 10
shot arrow-tap-neighbours-terminal-control
