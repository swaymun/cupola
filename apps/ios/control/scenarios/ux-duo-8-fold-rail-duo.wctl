check-layout duo-rail --expect rail,toggled,keyboard --settle 6
tap --id open-sidebar --timeout 5
wait --id open-sidebar --timeout 5
check-layout duo-rail --expect rail,keyboard --settle 6
# transition 5: folded after Home
# sent Home and back first: the scene returns in the posture it was left in
button home
activate
