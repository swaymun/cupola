# With Steer chosen as the follow-up behavior, plain Send into a reply T3 Code
# runs in a Claude thread goes into that reply through T3 Code: no "open in T3
# Code" hold note, no Take over offer. Host response fixture only; nothing
# reaches a real Mac.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture send-states --fixture send-claude --fixture send-held-by-app --fixture t3-code --fixture t3-code-running --arg=-wonder.send.followUp --arg=steer
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:claude:read-fixture --timeout 20
tap --id pinned-thread:claude:read-fixture
wait --id message-draft --timeout 15
wait --contains "Working on the release notes in T3 Code." --timeout 10
sidebar open
wait --id sidebar-settings --timeout 10
tap --id sidebar-settings
tap --id settings-computer:diagnostic-host
swipe up
wait --id connection-connected-apps --timeout 10
tap --id connection-connected-apps
tap --id t3code-connect
wait --id t3code-status --contains "Connected" --timeout 15
# Back through the computer page and Settings to the thread.
back
back
back
wait --id stop-response --timeout 15
wait --id open-elsewhere --gone --timeout 5
wait --id send-message --gone --timeout 5
tap --id message-draft --type TextArea
type "Also check the dates"
wait --id send-message --timeout 15
wait --label "Take over" --never 1
shot t3-steer-before-send
tap --id send-message
wait --contains "T3 Code took your message into this reply." --timeout 15
wait --contains "Also check the dates" --timeout 5
wait --label "Take over" --never 1
wait --id open-elsewhere --gone --timeout 5
shot t3-steer-steered
