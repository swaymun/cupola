# nightly-ipad: a message taller than the screen keeps its proportions when lifted
# visual-review: a tall message lifts at full size from its opening, not shrunk or cropped
# Long-press a pasted prompt taller than the screen: the context-menu preview
# shows the bubble's text at its own shape, not squeezed to fit. Nothing is sent.
launch --fixture subagent-fixture --fixture chat-layout --fixture chat-layout-unsaved --fixture project-actions --fixture project-tall-message
wait --id open-sidebar --timeout 30
sidebar open
wait --id pinned-thread:codex:read-fixture --timeout 20
tap --id pinned-thread:codex:read-fixture
wait --contains "Tall handoff" --timeout 20
hold --contains "Step 20: read the nightly report"
wait --id copy-message --timeout 10
shot menu-preview-tall
tap --id copy-message
wait --id copy-message --gone --timeout 10
